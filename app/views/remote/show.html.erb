<% content_for :title, "Tunnel remote" %>
<% default_aircraft = @last_flight&.aircraft_id %>
<% default_pilot = @last_flight&.pilot_id || Current.user.id %>

<main class="remote" data-controller="remote" data-phase="<%= @state[:phase] %>"
  data-action="flight-debrief:published->remote#published flight-debrief:abandoned->remote#abandoned"
  data-remote-state-url-value="<%= remote_state_path %>" data-remote-flights-url-value="<%= remote_flights_path %>"
  data-remote-initial-value="<%= @state.to_json %>">
  <header class="remote-top">
    <%= link_to root_path, class: "remote-exit", aria: { label: "Leave the remote" }, title: "Leave the remote" do %><%= sillage_icon "x", size: 20 %><% end %>
    <strong data-remote-target="title">Tunnel session</strong>
    <span class="remote-link" data-remote-target="link" data-state="idle">Ground station</span>
  </header>

  <%# 1. Next flight %>
  <section class="remote-screen" data-remote-phases="ready" aria-label="Next flight">
    <div class="remote-body">
      <div><span class="remote-eyebrow">Next flight</span><p class="remote-code" data-remote-target="count">Flight 1</p></div>
      <label class="remote-pick"><span>Wing</span>
        <%= select_tag :aircraft_id, options_from_collection_for_select(@aircraft, :id, :display_name, default_aircraft), include_blank: "No wing", data: { remote_target: "aircraft" } %>
      </label>
      <label class="remote-pick"><span>Pilot</span>
        <%= select_tag :pilot_id, options_for_select(@pilots.map { |pilot| [ pilot.full_name || pilot.email_address, pilot.id ] }, default_pilot), data: { remote_target: "pilot" } %>
      </label>
      <p class="remote-hint">Wing and pilot stay as they were on the last flight. Change them only when they change.</p>
      <p class="remote-error" role="alert" data-remote-target="error" hidden></p>
    </div>
    <footer class="remote-foot">
      <button type="button" class="remote-big" data-action="remote#start"><%= sillage_icon "play", size: 26 %><span>Start flight</span></button>
    </footer>
  </section>

  <%# 1b. Waiting for the ground station %>
  <section class="remote-screen" data-remote-phases="starting" hidden aria-label="Starting">
    <div class="remote-body is-centered">
      <span class="remote-spinner" aria-hidden="true"></span>
      <p class="remote-code" data-remote-target="code">Flight</p>
      <p class="remote-hint" role="status">Waiting for the ground station to start recording. It must be open on Signal in tunnel station mode with the radio connected.</p>
    </div>
    <footer class="remote-foot">
      <button type="button" class="remote-mid" data-action="remote#cancel">Cancel this start</button>
    </footer>
  </section>

  <%# 2. Flight in progress %>
  <section class="remote-screen" data-remote-phases="flight" hidden aria-label="Flight in progress">
    <div class="remote-body">
      <div><p class="remote-name" data-remote-target="pilotName">Pilot</p><span class="remote-eyebrow" data-remote-target="aircraftName">Wing</span></div>
      <div class="remote-time"><span class="remote-eyebrow">Flight time</span><output class="remote-clock" data-remote-target="clock">00:00</output></div>
      <p class="remote-hint" role="status" data-remote-target="flightStatus">Recording on the ground station.</p>
    </div>
    <footer class="remote-foot">
      <button type="button" class="remote-big is-stop" data-action="remote#end"><span class="remote-stop-icon" aria-hidden="true"></span><span>End flight</span></button>
      <button type="button" class="remote-mid" data-remote-target="forceClose" data-action="remote#forceClose" hidden>Close without the ground station</button>
      <p class="remote-hint is-centered">Stops the recording and starts the debrief.</p>
    </footer>
  </section>

  <%# 3. Debrief: one recorder per flight, kept alive while it uploads %>
  <section class="remote-screen" data-remote-phases="debrief" hidden aria-label="Debrief">
    <div class="remote-debriefs" data-remote-target="debriefs"></div>
  </section>
</main>
