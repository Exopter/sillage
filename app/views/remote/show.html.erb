<% content_for :title, "Tunnel remote" %>
<% default_aircraft = @last_flight&.aircraft_id %>
<% default_pilot = @last_flight&.pilot_id || Current.user.id %>

<main class="remote" data-controller="remote" data-phase="<%= @state[:phase] %>"
  data-action="flight-debrief:published->remote#published flight-debrief:abandoned->remote#abandoned"
  data-remote-state-url-value="<%= remote_state_path %>" data-remote-flights-url-value="<%= remote_flights_path %>"
  data-remote-initial-value="<%= @state.to_json %>">
  <header class="remote-top">
    <%= link_to root_path, class: "remote-exit", aria: { label: "Leave the remote" }, title: "Leave the remote" do %><%= sillage_icon "x", size: 20 %><% end %>
    <strong data-remote-target="title">Tunnel session</strong>
    <span class="remote-link" data-remote-target="link" data-state="idle">Ready</span>
  </header>

  <%# 1. Next flight %>
  <section class="remote-screen" data-remote-phases="ready" aria-label="Next flight">
    <div class="remote-body">
      <p class="remote-saved" role="status" data-remote-target="saved" hidden><%= sillage_icon "circle-check", size: 20 %><span data-remote-target="savedText"></span></p>
      <div class="remote-next">
        <span class="remote-eyebrow">Next flight</span>
        <p class="remote-code" data-remote-target="count">Flight 1</p>
      </div>
      <label class="remote-pick"><span>Aircraft</span>
        <%= select_tag :aircraft_id, options_from_collection_for_select(@aircraft, :id, :display_name, default_aircraft), include_blank: "No aircraft", data: { remote_target: "aircraft" } %>
      </label>
      <label class="remote-pick"><span>Pilot</span>
        <%= select_tag :pilot_id, options_for_select(@pilots.map { |pilot| [ pilot.full_name || pilot.email_address, pilot.id ] }, default_pilot), data: { remote_target: "pilot" } %>
      </label>
      <p class="remote-hint">Aircraft and pilot stay as they were on the last flight.</p>
      <p class="remote-error" role="alert" data-remote-target="error" hidden></p>
    </div>
    <footer class="remote-foot">
      <button type="button" class="remote-big" data-action="remote#start"><span class="remote-big-icon"><%= sillage_icon "play", size: 22 %></span><span>Start flight</span></button>
    </footer>
  </section>

  <%# 2. Flight in progress, recorded by the ground station or running on the phone alone %>
  <section class="remote-screen" data-remote-phases="flight" hidden aria-label="Flight in progress">
    <div class="remote-body">
      <div><p class="remote-name" data-remote-target="pilotName">Pilot</p><span class="remote-eyebrow" data-remote-target="aircraftName">Aircraft</span></div>
      <div class="remote-time">
        <span class="remote-eyebrow">Flight time</span>
        <output class="remote-clock" data-remote-target="clock">00:00</output>
        <svg class="remote-trace" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M0 12 C 50 2, 100 22, 150 12 S 250 2, 300 12"/></svg>
      </div>
      <p class="remote-status" role="status" data-remote-target="flightStatus">Waiting for the ground station.</p>
    </div>
    <footer class="remote-foot">
      <button type="button" class="remote-big is-stop" data-action="remote#end"><span class="remote-stop-icon" aria-hidden="true"></span><span>End flight</span></button>
      <div class="remote-foot-row">
        <button type="button" class="remote-text" data-remote-target="forceClose" data-action="remote#forceClose" hidden>Close without the ground station</button>
        <button type="button" class="remote-text is-danger" data-remote-target="cancel" data-action="remote#cancel" hidden>Cancel this flight</button>
      </div>
    </footer>
  </section>

  <%# 3. Debrief: one recorder per flight, kept alive while it uploads %>
  <section class="remote-screen" data-remote-phases="debrief" hidden aria-label="Debrief">
    <div class="remote-debriefs" data-remote-target="debriefs"></div>
  </section>
</main>
