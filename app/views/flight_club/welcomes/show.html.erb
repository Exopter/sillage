<% content_for :title, "Welcome to the Flight Club" %>
<% founding = @member.membership_tier == "pioneer" %>

<%= tag.main class: "flight-club-welcome", data: flight_club_card_data(@member).merge(stage: "invitation") do %>
  <%= render "shared/flight_club_masthead", member: @member %>

  <section class="flight-club-prelude" aria-labelledby="flight-club-prelude-title">
    <span class="flight-club-emblem"><%= image_tag "logo-mark.svg", alt: "" %></span>
    <h1 id="flight-club-prelude-title"><%= founding ? "Welcome to the first chapter." : "Welcome to the Flight Club." %></h1>
    <p><%= @member.first_name %>, you are <%= @member.membership_rank_phrase %>.<br>Your place in the Flight Club starts here.</p>
    <button type="button" class="flight-club-action" data-action="membership-card#reveal">
      <span>Reveal my card</span><span aria-hidden="true">↗</span>
    </button>
  </section>

  <%= render "shared/flight_club_card", member: @member %>

  <section class="flight-club-arrival" aria-label="Your membership">
    <div class="flight-club-identity">
      <span class="flight-club-micro">Your place in the club</span>
      <h2><%= @member.full_name %> <span class="flight-club-rank"><%= @member.membership_rank %></span></h2>
      <p><%= @member.membership_status %> <%= @member.member_code %>.</p>
    </div>
    <ul class="flight-club-benefits">
      <li><strong>Your flight log</strong><span>Your flights, recorded and replayed in one place.</span></li>
      <li><strong>Your card, always with you.</strong><span>Find it anytime in My profile.</span></li>
    </ul>
    <div class="flight-club-controls">
      <%= button_to flight_club_welcome_path, method: :patch, class: "flight-club-action" do %>
        <span>Enter Sillage</span><span aria-hidden="true">↗</span>
      <% end %>
      <button type="button" class="flight-club-link" data-action="membership-card#turn" data-membership-card-target="turnLabel">Turn card</button>
      <button type="button" class="flight-club-link" data-action="membership-card#reveal">Replay</button>
    </div>
  </section>

  <p class="flight-club-live" aria-live="polite" data-membership-card-target="announcement"></p>
<% end %>
