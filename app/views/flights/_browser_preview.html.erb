<%= turbo_frame_tag "flight-preview", class: "exds-browser-preview", role: "region", aria: { label: "Flight details" } do %>
  <button type="button" class="button-secondary exds-btn exds-btn--secondary exds-browser-mobile-back" data-action="flight-browser#backToFlights"><%= sillage_icon "chevron-left", size: 16 %> Back to flights</button>
  <% if entry %>
    <% flight = entry.is_a?(Flight) %>
    <% accessible = !flight || entry.visible_to?(Current.user) %>
    <header class="exds-browser-preview-heading"><div><h2><%= browser_name(entry) %></h2><% subtitle = entry.import_type.upcase unless flight %><% if subtitle.present? %><p><%= subtitle %></p><% end %></div>
      <% manageable = flight && can_manage_flight?(entry) %>
      <% openable = !(flight && entry.logbook_view?) %>
      <% editable_flight = manageable %>
      <% if manageable || openable || editable_flight %>
        <div class="exds-browser-preview-actions">
          <%# The way into the flight leads the header actions, level with the title. %>
          <% if openable %><%= link_to browser_open_path(entry), class: "button-primary exds-btn exds-btn--primary", data: { turbo_frame: "_top" } do %><%= sillage_icon "arrow-up-right", size: 18 %> <%= flight ? "Open flight" : "Open recording" %><% end %><% end %>
          <% if manageable && !entry.live? %><%= link_to "##{dom_id(entry, :debrief)}", class: "exds-browser-icon-button", title: "Record debrief", aria: { label: "Record debrief" }, data: { turbo: false } do %><%= sillage_icon "mic", size: 17 %><% end %><% end %>
          <% if editable_flight %><%= link_to edit_flight_path(entry, **browser_context), class: "exds-browser-icon-button", aria: { label: "Edit flight" }, data: { turbo_frame: "flight-browser" } do %><%= sillage_icon "pencil", size: 17 %><% end %><% end %>
          <% if manageable %>
            <% unless entry.live? %>
              <details class="exds-browser-preview-menu exds-comment-actions">
                <summary class="exds-browser-icon-button" title="More actions" aria-label="More actions for <%= entry.label %>"><%= sillage_icon "ellipsis", size: 17 %></summary>
                <div class="exds-comment-menu">
                  <%# The browser context brings the operator back to the same folder, filter and search. %>
                  <%= button_to flight_path(entry, **browser_context.except(:page), browser: 1), method: :delete,
                        form: { data: { turbo_frame: "_top", turbo_confirm: t("flights.show.confirm_delete", name: entry.label) } } do %><%= sillage_icon "trash", size: 16 %> Delete flight<% end %>
                </div>
              </details>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </header>
    <% if @preview_points.any? %>
      <div data-controller="flight-preview-map" data-flight-preview-map-points-value="<%= @preview_points.to_json %>">
        <div class="exds-browser-map"><div class="exds-browser-map-canvas" data-flight-preview-map-target="canvas" role="img" aria-label="Recorded flight route"></div></div>
        <p class="exds-browser-map-status" data-flight-preview-map-target="status" role="status">Loading recorded route…</p>
      </div>
    <% end %>
    <% preview_videos = accessible ? Array(@preview_videos) : [] %>
    <% editable = editable_flight && !entry.live? %>
    <dl class="exds-browser-metadata">
      <% if flight %><div><dt>Pilot</dt><dd>
        <% if editable %>
          <%= render layout: "flights/inline_edit", locals: { flight: entry, label: "pilot", fields: ->(form) { form.collection_select :pilot_id, flight_pilot_options(entry), :id, ->(pilot) { pilot.full_name || pilot.email_address }, {}, required: true, aria: { label: "Pilot" }, data: { action: "change->inline-edit#submit" } } } do %><%= render "flights/pilot", flight: entry %><% end %>
        <% else %><%= render "flights/pilot", flight: entry %><% end %>
      </dd></div><% end %>
      <% if flight %><div><dt>Mode</dt><dd>
        <% if editable %>
          <%= render layout: "flights/inline_edit", locals: { flight: entry, label: "mode", fields: ->(form) { form.select :environment, [["Sky", "sky"], ["Tunnel", "tunnel"]], {}, aria: { label: "Mode" }, data: { action: "change->inline-edit#submit" } } } do %><%= entry.environment_label %><% end %>
        <% else %><%= entry.environment_label %><% end %>
      </dd></div><% end %>
      <% unless flight %><div><dt>Aircraft</dt><dd><%= logbook_value(entry.aircraft&.registration) %></dd></div><% end %>
      <div><dt>Date</dt><dd>
        <% if editable %>
          <%= render layout: "flights/inline_edit", locals: { flight: entry, label: "date", save: true, fields: ->(form) { safe_join([ form.date_field(:flown_on, value: entry.display_flown_on, required: true, aria: { label: "Date" }), form.time_field(:flown_at, aria: { label: "Time (optional)" }) ]) } } do %><%= logbook_date(entry) %><% end %>
        <% else %><%= logbook_date(entry) %><% end %>
      </dd></div>
      <% if flight %><div><dt>Location</dt><dd>
        <% if editable %>
          <%= render layout: "flights/inline_edit", locals: { flight: entry, label: "location", save: true, fields: ->(form) { form.text_field :location, required: !entry.preparation? && entry.sky?, autocomplete: "off", aria: { label: "Location" }, placeholder: "Airfield, drop zone or operating location" } } do %><%= entry.display_location %><% end %>
        <% else %><%= entry.display_location %><% end %>
      </dd></div><% end %>
      <%# A flight with a recording but no flight time shows the gap rather than the length of the recording. %>
      <% flight_time = browser_duration(entry) %>
      <% if !flight || flight_time.present? || entry.sample_count.positive? || entry.sensor_sample_count.positive? %><div><dt><%= flight ? "Flight time" : "Duration" %></dt><dd><%= logbook_duration(flight_time) %></dd></div><% end %>
      <% state, label = flight ? logbook_status(entry) : recording_logbook_status(entry) %>
      <% editable_status = editable && label && entry.completable_without_recording? %>
      <% if editable_status %>
        <div><dt>Status</dt><dd>
          <%= render layout: "flights/inline_edit", locals: { flight: entry, label: "status", fields: ->(form) { form.select :status, [[label, "waiting_for_recording"], ["Completed", "completed"]], {}, aria: { label: "Status" }, data: { action: "change->inline-edit#submit" } } } do %>
            <span class="status-dot is-<%= state %>"><span></span><%= label %></span>
          <% end %>
        </dd></div>
      <% elsif label %>
        <div><dt>Status</dt><dd><span class="status-dot is-<%= state %>"><span></span><%= label %></span></dd></div>
      <% end %>
    </dl>
    <% if flight %>
      <% if can_access_signal? && entry.live? && (live_session = entry.signal_sessions.where(status: %w[live syncing]).first) %>
        <%= link_to "Join live session", signal_path(session: live_session.uuid, join: 1), class: "exds-btn exds-btn--primary", data: { turbo_frame: "_top" } %>
      <% end %>
      <%= render "flight_comments/comments", flight: entry %>
      <% video_manageable = manageable %>
      <% if video_manageable || preview_videos.any? || entry.video_ready? %>
        <%# The videos follow the discussion in their own section. Whoever can see the flight adds one from here and stays in the browser. %>
        <%= render "flights/videos_panel", flight: entry, videos: preview_videos, upload: video_manageable, return_parameters: browser_context %>
      <% end %>
      <%= render "flights/log_equipment", flight: entry %>
    <% end %>
    <dl class="exds-browser-metadata">
      <% if flight && (accessible || entry.folder&.visible_to?(Current.user)) %>
        <div data-folder-color-id="<%= entry.folder_id %>" style="--exds-folder-color: <%= browser_folder_color(entry.folder) %>"><dt>Folder</dt><dd><%= sillage_icon "folder", size: 22, class_name: "exds-browser-folder-icon" %><%= entry.folder&.name || "Unfiled" %>
          <% if can_manage_operations? && accessible %>
            <button type="button" class="exds-browser-icon-button is-quiet" title="Move flight" aria-label="Move flight" data-action="flight-browser#moveFlight" data-flight-key="<%= browser_key(entry) %>" data-flight-name="<%= browser_name(entry) %>" data-folder-id="<%= entry.folder_id || 'unfiled' %>"><%= sillage_icon "folder", size: 17 %><%= sillage_icon "chevron-down", size: 12 %></button>
          <% end %>
        </dd></div>
      <% end %>
      <div><dt>Visibility</dt><dd><%= sillage_icon(browser_visibility(entry) == "private" ? "lock-keyhole" : "users", size: 19) %><%= visibility_label(browser_visibility(entry)) %><% if flight && entry.folder %><small>From folder</small><% elsif editable_flight %><%= link_to edit_flight_path(entry, **browser_context), class: "exds-browser-icon-button is-quiet", title: "Edit flight visibility", aria: { label: "Edit flight visibility" }, data: { turbo_frame: "flight-browser" } do %><%= sillage_icon "pencil", size: 16 %><% end %><% end %></dd></div>
    </dl>
  <% else %>
    <div class="exds-browser-empty"><%= sillage_icon "plane", size: 40 %><strong>Select a flight</strong><span>Its comments and details will appear here.</span></div>
  <% end %>
<% end %>
