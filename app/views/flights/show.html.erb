<% content_for :title, @flight.code %>
<% content_for :body_class, "flight-analysis-theme" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://api.cesium.com" crossorigin>
  <link rel="preconnect" href="https://assets.cesium.com" crossorigin>
  <link rel="preload" href="<%= Rails.application.config.x.cesium_base_url %>Cesium.js" as="script">
  <link rel="stylesheet" href="<%= Rails.application.config.x.cesium_base_url %>Widgets/widgets.css">
<% end %>

<%
  point_at = lambda do |elapsed|
    next unless elapsed

    @visualization_points.min_by { |point| (point[:t].to_f - elapsed.to_f).abs }
  end
  exit_point = point_at.call(@bounds[:exit])
  opening_point = point_at.call(@bounds[:opening])
  total_duration = @analysis[:duration_seconds] || @flight.duration_seconds || 0
  jump_duration = @bounds[:exit] && @bounds[:opening] ? @bounds[:opening] - @bounds[:exit] : nil
  canopy_duration = @bounds[:opening] && @bounds[:landing] ? @bounds[:landing] - @bounds[:opening] : nil
  combined_imu_count = @sensor_counts.fetch("IMU", 0)
  imu_sample_rows = [
    ["Accelerometer samples (IMU)", @sensor_counts.fetch("IMU:accelerometer", 0) + combined_imu_count],
    ["Gyroscope samples (IMU)", @sensor_counts.fetch("IMU:gyroscope_calibrated", 0) + @sensor_counts.fetch("IMU:gyroscope", 0) + combined_imu_count],
    ["Magnetometer samples (IMU)", @sensor_counts.fetch("IMU:magnetic_field_calibrated", 0) + @sensor_counts.fetch("IMU:magnetometer", 0)],
    ["Orientation samples (IMU)", @sensor_counts.fetch("IMU:rotation_vector", 0)]
  ]
%>

<h1 class="sr-only"><%= @flight.name %></h1>

<section
  class="flight-replay-page"
  data-controller="flight-viewer"
  data-flight-viewer-points-value="<%= json_escape(@visualization_points.to_json) %>"
  data-flight-viewer-sensors-value="<%= json_escape(@visualization_sensors.to_json) %>"
  data-flight-viewer-bounds-value="<%= json_escape(@bounds.to_json) %>"
  data-flight-viewer-analysis-value="<%= json_escape(@analysis.to_json) %>"
  data-flight-viewer-cesium-token-value="<%= @cesium_ion_token %>"
  data-flight-viewer-cesium-base-url-value="<%= Rails.application.config.x.cesium_base_url %>"
  data-flight-viewer-labels-value="<%= json_escape(t("flights.charts").to_json) %>"
  <% if @flight.video_exit_offset_seconds.present? %>
    data-flight-viewer-video-exit-offset-value="<%= @flight.video_exit_offset_seconds %>"
  <% end %>>
  <header class="flight-replay-header">
    <%= link_to flights_path, class: "kit-icon-button", title: "Back to flights", aria: { label: "Back to flights" } do %>
      <%= sillage_icon "chevron-right", size: 18, class_name: "is-back-icon" %>
    <% end %>
    <div class="flight-replay-title">
      <span><%= @flight.name %></span>
    </div>
    <span class="mode-badge is-neutral">Replay</span>
  </header>

  <div class="flight-replay-content">
    <div class="flight-analysis-workspace">
    <% if @flight.waiting_for_recording? %>
      <section class="analysis-mode-banner" aria-label="Waiting for recording">
        <strong>Waiting for recording</strong>
        <span>Signal capture is complete. Import the microSD recording to analyse the authoritative flight data.</span>
        <%= link_to "Import recording", new_flight_import_path(flight_id: @flight.id) %>
      </section>
    <% end %>
    <% if @flight_analysis.degraded? %>
      <section class="analysis-mode-banner" aria-label="<%= t("flights.analysis.degraded_badge") %>">
        <strong><%= t("flights.analysis.degraded_title") %></strong>
        <span><%= @flight_analysis.reason %></span>
      </section>
    <% end %>

    <section class="flight-overview-strip" aria-label="Flight overview">
      <div>
        <span>Total recording</span>
        <strong><%= duration(total_duration) %></strong>
      </div>
      <div>
        <span>Exit</span>
        <strong><%= exit_point&.dig(:alt)&.round || "—" %><small> m</small></strong>
      </div>
      <div>
        <span>Jump</span>
        <strong><%= jump_duration ? duration(jump_duration) : "—" %></strong>
      </div>
      <div>
        <span>Opening</span>
        <strong><%= opening_point&.dig(:alt)&.round || "—" %><small> m</small></strong>
      </div>
      <div>
        <span>Canopy</span>
        <strong><%= canopy_duration ? duration(canopy_duration) : "—" %></strong>
      </div>
    </section>

    <section class="flight-instrument-panel" aria-labelledby="flight-data-title">
      <div class="flight-section-heading flight-analysis-heading">
        <div>
          <span class="flight-section-kicker">Telemetry</span>
          <h2 id="flight-data-title">Unified flight data</h2>
          <p>Every signal shares one timeline. Select a phase to zoom automatically.</p>
        </div>
        <div class="flight-analysis-toolbar">
          <output class="flight-phase-range" data-flight-viewer-target="phaseRange">Full recording</output>
          <nav class="flight-phase-filter" aria-label="Flight phase" role="group">
            <% [ ["all", "All"], ["plane", "Plane"], ["jump", "Jump"], ["canopy", "Canopy"] ].each do |phase, label| %>
              <button
                type="button"
                class="flight-phase-button<%= " is-active" if phase == "all" %>"
                data-flight-viewer-target="phaseButton"
                data-action="flight-viewer#selectPhase"
                data-phase="<%= phase %>"
                aria-pressed="<%= phase == "all" %>"><%= label %></button>
            <% end %>
          </nav>
        </div>
      </div>

      <div class="flight-analysis-visuals">
        <div class="flight-chart-stage">
          <canvas data-flight-viewer-target="unifiedChart" class="unified-analysis-chart" aria-label="Combined flight telemetry chart"></canvas>
        </div>

        <section class="trajectory trajectory-compact" aria-labelledby="trajectory-title">
          <div class="trajectory-header">
            <div>
              <span class="flight-section-kicker">Spatial replay</span>
              <h2 id="trajectory-title"><%= t("flights.show.trajectory") %></h2>
            </div>
            <div class="trajectory-toolbar">
              <button type="button" class="trajectory-icon-button trajectory-play-button" data-flight-viewer-target="playButton" data-action="flight-viewer#togglePlayback" aria-label="<%= t("flights.charts.play") %>" title="<%= t("flights.charts.play") %>">
                <span class="play-icon is-play"><%= sillage_icon "play", size: 16 %></span>
                <span class="play-icon is-pause"><%= sillage_icon "pause", size: 16 %></span>
              </button>
              <output data-flight-viewer-target="timeLabel" class="trajectory-time">00:00</output>
              <button type="button" class="trajectory-icon-button" data-action="flight-viewer#resetCamera" aria-label="<%= t("flights.charts.reset_camera") %>" title="<%= t("flights.charts.reset_camera") %>">
                <%= sillage_icon "rotate-ccw", size: 16 %>
              </button>
            </div>
          </div>
          <div data-flight-viewer-target="scene" class="trajectory-scene"></div>
          <div data-flight-viewer-target="credits" class="trajectory-credits" aria-label="Map data attribution"></div>
          <input data-flight-viewer-target="scrubber" data-action="input->flight-viewer#scrub" class="scrubber" type="range" min="0" max="1000" value="0" aria-label="Replay position">
        </section>
      </div>

      <div class="flight-metric-controls" aria-label="Visible metrics">
        <% [
          ["altitude", "Altitude", "is-aqua", true],
          ["horizontal-speed", "Horizontal speed", "is-sky", true],
          ["vertical-speed", "Vertical speed", "is-amber", true],
          ["airspeed", "Airspeed", "is-lime", false],
          ["total-speed", "Total speed", "is-violet", false],
          ["glide", "Glide ratio", "is-coral", false],
          ["distance", "Distance", "is-graphite", false],
          ["load", "G-force", "is-field", false]
        ].each do |metric, label, color_class, checked| %>
          <label class="flight-metric-toggle <%= color_class %>">
            <input
              type="checkbox"
              <%= "checked" if checked %>
              data-flight-viewer-target="metricToggle"
              data-action="change->flight-viewer#toggleMetric"
              data-metric="<%= metric %>">
            <span class="flight-toggle-track" aria-hidden="true"><span></span></span>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </section>

    <section class="flight-statistics" aria-labelledby="flight-statistics-title">
      <div class="flight-section-heading">
        <h2 id="flight-statistics-title"><span data-flight-viewer-target="phaseName">All</span> statistics</h2>
      </div>

      <div class="flight-stat-grid">
        <article class="flight-stat-card">
          <header><span>Phase summary</span><strong data-flight-viewer-target="stat" data-stat="duration">—</strong></header>
          <dl>
            <div><dt>Distance</dt><dd data-flight-viewer-target="stat" data-stat="distance">—</dd></div>
            <div><dt>Glide ratio</dt><dd data-flight-viewer-target="stat" data-stat="glide">—</dd></div>
            <div><dt>Peak load</dt><dd data-flight-viewer-target="stat" data-stat="peak-load">—</dd></div>
          </dl>
        </article>

        <article class="flight-stat-card">
          <header><span>Speed envelope</span><small>Avg / max</small></header>
          <dl>
            <% [
              ["horizontal-speed", "Horizontal speed"],
              ["vertical-speed", "Vertical speed"],
              ["airspeed", "Airspeed"],
              ["total-speed", "Total speed"]
            ].each do |key, label| %>
              <div>
                <dt><%= label %></dt>
                <dd class="flight-speed-values">
                  <span class="flight-speed-pill is-average">
                    <span class="sr-only">Average</span>
                    <span data-flight-viewer-target="stat" data-stat="<%= key %>-average">—</span>
                    <span class="flight-speed-unit">km/h</span>
                  </span>
                  <span class="flight-speed-pill is-maximum">
                    <span class="sr-only">Maximum</span>
                    <span data-flight-viewer-target="stat" data-stat="<%= key %>-maximum">—</span>
                    <span class="flight-speed-unit">km/h</span>
                  </span>
                </dd>
              </div>
            <% end %>
          </dl>
        </article>

        <article class="flight-stat-card">
          <header><span>Source data</span><small>Samples</small></header>
          <dl class="flight-source-grid">
            <div><dt>GPS samples</dt><dd><%= sample_count_with_rate(@flight.sample_count, total_duration) %></dd></div>
            <div><dt>Airspeed samples</dt><dd><%= sample_count_with_rate(@sensor_counts.fetch("AIRSPEED", 0), total_duration) %></dd></div>
            <% imu_sample_rows.each do |label, count| %>
              <div><dt><%= label %></dt><dd><%= sample_count_with_rate(count, total_duration) %></dd></div>
            <% end %>
          </dl>
        </article>
      </div>
    </section>
    </div>

    <section class="flight-instrument-panel video-sync">
      <div class="video-sync-header">
        <div>
          <span class="flight-section-kicker">Visual reference</span>
          <h2><%= t("flights.video.title") %></h2>
          <p><%= t("flights.video.hint") %></p>
        </div>

        <%= form_with model: @flight, html: { multipart: true, class: "video-upload-form", data: { controller: "upload", turbo: false, action: "submit->upload#start", upload_failed_label_value: t("flights.video.upload_failed"), upload_processing_label_value: t("flights.video.uploading") } } do |form| %>
          <label class="secondary-button video-upload-button">
            <%= sillage_icon "upload", size: 18 %>
            <span><%= t(@flight.video.attached? ? "flights.video.replace" : "flights.video.upload") %></span>
            <%= form.file_field :video_upload, accept: "video/*,.avi,.m4v,.mkv,.mov,.mp4,.webm", data: { upload_target: "input", action: "change->upload#showFiles" } %>
          </label>
          <span class="file-summary" data-upload-target="summary"><%= t("flights.video.no_file") %></span>
          <%= form.button class: "primary-button", data: { upload_target: "submit" } do %>
            <%= sillage_icon "settings", size: 18 %>
            <span><%= t("flights.video.process") %></span>
          <% end %>
          <div class="upload-progress" data-upload-target="progress" hidden>
            <div class="upload-progress-track" role="progressbar" aria-label="<%= t("flights.video.upload_progress") %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-upload-target="meter">
              <span class="upload-progress-bar" data-upload-target="bar"></span>
            </div>
            <span class="upload-progress-percent" data-upload-target="percent">0%</span>
          </div>
        <% end %>
      </div>

      <% if @flight.video_ready? %>
        <div class="video-stage">
          <video data-flight-viewer-target="video" data-action="loadedmetadata->flight-viewer#syncVideoFromFlight play->flight-viewer#videoPlaybackStarted pause->flight-viewer#videoPlaybackPaused seeked->flight-viewer#videoSeeked timeupdate->flight-viewer#videoTimeUpdated" class="flight-video" controls playsinline preload="metadata" src="<%= url_for(@flight.video) %>"></video>
        </div>
        <div class="video-sync-controls">
          <%= form_with model: @flight, class: "video-exit-form" do |form| %>
            <%= form.hidden_field :video_exit_offset_seconds, value: @flight.video_exit_offset_seconds, data: { flight_viewer_target: "videoExitOffsetInput" } %>
            <%= button_tag type: "button", class: "secondary-button", data: { action: "flight-viewer#markVideoExit" } do %>
              <%= sillage_icon "crosshair", size: 18 %>
              <span><%= t("flights.video.mark_exit") %></span>
            <% end %>
          <% end %>
          <span data-flight-viewer-target="videoExitOffsetLabel" class="video-sync-state">
            <%= @flight.video_exit_offset_seconds.present? ? t("flights.video.exit_marked", timestamp: duration(@flight.video_exit_offset_seconds)) : t("flights.video.exit_unmarked") %>
          </span>
        </div>
      <% elsif @flight.video_processing? %>
        <p class="video-status"><%= t("flights.video.processing") %></p>
      <% elsif @flight.video_failed? %>
        <p class="video-status error-text"><%= t("flights.video.failed", error: @flight.video_processing_error.presence || t("flights.video.unknown_error")) %></p>
      <% else %>
        <p class="video-status"><%= t("flights.video.empty") %></p>
      <% end %>
    </section>

    <section class="flight-support-grid">
      <div class="flight-instrument-panel">
        <div class="flight-section-heading">
          <div>
            <span class="flight-section-kicker">Flight record</span>
            <h2><%= t("flights.show.details") %></h2>
          </div>
        </div>
        <%= form_with model: @flight, class: "details-form" do |form| %>
          <%= form.label :name, t("flights.form.name") %>
          <%= form.text_field :name %>
          <%= form.label :aircraft_id, t("flights.form.aircraft") %>
          <%= form.collection_select :aircraft_id, @aircraft, :id, :display_name, { include_blank: "No aircraft" } %>
          <%= form.label :location, t("flights.form.location") %>
          <%= form.text_field :location %>
          <div class="flight-details-time-grid">
            <div><%= form.label :exit_at, t("flights.form.exit_at") %><%= form.datetime_field :exit_at, value: @flight.exit_at&.strftime("%Y-%m-%dT%H:%M:%S") %></div>
            <div><%= form.label :opening_at, t("flights.form.opening_at") %><%= form.datetime_field :opening_at, value: @flight.opening_at&.strftime("%Y-%m-%dT%H:%M:%S") %></div>
            <div><%= form.label :landing_at, t("flights.form.landing_at") %><%= form.datetime_field :landing_at, value: @flight.landing_at&.strftime("%Y-%m-%dT%H:%M:%S") %></div>
          </div>
          <%= form.label :notes, t("flights.form.notes") %>
          <%= form.text_area :notes, rows: 4 %>
          <%= form.button class: "primary-button" do %>
            <%= sillage_icon "check", size: 18 %>
            <span><%= t("flights.form.save") %></span>
          <% end %>
        <% end %>
      </div>

      <div class="flight-instrument-panel danger-panel">
        <div class="flight-section-heading">
          <div>
            <span class="flight-section-kicker">Record management</span>
            <h2><%= t("flights.show.danger") %></h2>
          </div>
        </div>
        <%= button_to @flight, method: :delete, class: "danger-button", form: { data: { turbo_confirm: t("flights.show.confirm_delete") } } do %>
          <%= sillage_icon "octagon-x", size: 18 %>
          <span><%= t("flights.show.delete") %></span>
        <% end %>
      </div>
    </section>
  </div>
</section>
