<dl class="exds-browser-metadata">
  <div><dt>Date</dt><dd><%= logbook_date(@flight) %></dd></div>
  <div><dt>Location</dt><dd><%= @flight.display_location %></dd></div>
  <div><dt>Visibility</dt><dd><%= @flight.effective_visibility.capitalize %></dd></div>
  <% if @flight.owned_by?(Current.user) || @flight.folder&.visible_to?(Current.user) %>
    <div><dt>Folder</dt><dd><%= @flight.folder ? link_to(@flight.folder.name, flights_path(folder: @flight.folder_id), data: { turbo_frame: "flight-browser" }) : "Unfiled" %></dd></div>
  <% end %>
</dl>
<% if @flight.owned_by?(Current.user) %>
  <%= link_to edit_flight_path(@flight, **browser_context), class: "button-secondary", data: { turbo_frame: "flight-browser" } do %><%= sillage_icon "pencil", size: 16 %> Edit flight<% end %>
<% end %>
<%= render "flights/log_notes", flight: @flight %>
<%= render "flights/log_equipment", flight: @flight %>
