<%# Compact upload of the flight's own video. The file name and the confirmation only appear once a file is chosen. %>
<%= form_with model: flight, html: { multipart: true, class: "video-upload-form", data: { controller: "upload", turbo: false, action: "submit->upload#start", upload_failed_label_value: t("flights.video.upload_failed"), upload_processing_label_value: t("flights.video.uploading"), upload_retrying_label_value: t("flights.video.upload_retrying"), upload_chunked_url_value: flight_video_uploads_path(flight) } } do |form| %>
  <% if (return_parameters = local_assigns[:return_parameters]) %>
    <%# Uploaded from the flight browser: come back to the same list with this flight still selected. %>
    <%= hidden_field_tag :return_to_browser, "1", id: nil %>
    <% return_parameters.each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
  <% end %>
  <span class="file-summary" data-upload-target="summary"><%= t("flights.video.no_file") %></span>
  <label class="secondary-button exds-btn exds-btn--secondary video-upload-button">
    <%= sillage_icon "upload", size: 18 %>
    <span><%= t(flight.video.attached? ? "flights.video.replace" : "flights.video.upload") %></span>
    <%= form.file_field :video_upload, accept: "video/*,.avi,.m4v,.mkv,.mov,.mp4,.webm", data: { upload_target: "input", action: "change->upload#showFiles" } %>
  </label>
  <%= form.button class: "primary-button exds-btn exds-btn--primary video-upload-submit", data: { upload_target: "submit" } do %>
    <%= sillage_icon "settings", size: 18 %>
    <span><%= t("flights.video.process") %></span>
  <% end %>
  <div class="upload-progress" data-upload-target="progress" hidden>
    <div class="upload-progress-track" role="progressbar" aria-label="<%= t("flights.video.upload_progress") %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-upload-target="meter">
      <span class="upload-progress-bar" data-upload-target="bar"></span>
    </div>
    <span class="upload-progress-percent" data-upload-target="percent">0%</span>
  </div>
<% end %>
