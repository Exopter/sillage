<%= form.label :visibility, "Visibility when unfiled" %>
<%= form.select :visibility, [["Private", "private"], ["Public", "team"]], {}, aria: { describedby: "flight-visibility-help" } %>
<p class="operations-help" id="flight-visibility-help">Applies only outside a folder. Private: only you. Public: everyone signed in. A folder's visibility takes precedence.</p>
