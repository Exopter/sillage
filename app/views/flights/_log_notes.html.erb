<section class="exds-browser-editor-section" aria-label="Flight notes">
  <% if flight.owned_by?(Current.user) %>
    <%= form_with model: flight, class: "exds-browser-form", data: { turbo_frame: "flight-browser" } do |form| %>
      <%= hidden_field_tag :return_to_browser, "1", id: nil %>
      <% browser_context.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <label class="exds-browser-field">
        <span>Notes</span>
        <%= form.text_area :notes, rows: 5, placeholder: "Observations, conditions and anything to remember…" %>
      </label>
      <div class="exds-browser-form-actions"><%= form.submit "Save notes", class: "button-secondary" %></div>
    <% end %>
  <% else %>
    <h3>Notes</h3>
    <%= simple_format(flight.notes.presence || "No notes.") %>
  <% end %>
</section>
