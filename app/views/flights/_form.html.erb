<% preparation = flight.preparation? && !@logging_preparation %>
<%= form_with model: flight, class: "exds-browser-form", data: { turbo_frame: "flight-browser" } do |form| %>
  <%= hidden_field_tag :intent, preparation ? "prepare" : "log", id: nil %>
  <%= hidden_field_tag :return_to_browser, "1", id: nil %>
  <% browser_context.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
  <% if flight.errors.any? %>
    <div class="workspace-errors" role="alert"><%= flight.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="exds-browser-form-grid">
    <label class="exds-browser-field is-wide">
      <span>Pilot *</span>
      <%= form.collection_select :pilot_id, @pilots, :id, ->(pilot) { pilot.full_name || pilot.email_address }, { prompt: "Select a pilot" }, required: true %>
    </label>
    <label class="exds-browser-field">
      <span><%= preparation ? "Date (optional)" : "Date *" %></span>
      <%= form.date_field :flown_on, value: flight.flown_on || (flight.display_flown_on unless preparation || flight.errors[:flown_on].any?), required: !preparation %>
    </label>
    <label class="exds-browser-field">
      <span>Time (optional)</span>
      <%= form.time_field :flown_at, data: { controller: ("local-time" if !preparation && (flight.new_record? || @logging_preparation) && flight.errors.empty?) } %>
    </label>
    <div class="exds-browser-field is-wide" data-controller="location-suggestions" data-action="focusout->location-suggestions#leave">
      <%= form.label :location, preparation ? "Location (optional)" : "Location *" %>
      <div class="exds-browser-autocomplete">
        <%= form.text_field :location, required: !preparation, autocomplete: "off", role: "combobox", aria: { autocomplete: "list", expanded: "false", controls: "flight-location-suggestions", describedby: "flight-location-help" }, data: { location_suggestions_target: "input", action: "input->location-suggestions#search focus->location-suggestions#search keydown->location-suggestions#navigate" }, placeholder: "Airfield, drop zone or operating location" %>
        <div id="flight-location-suggestions" class="exds-browser-autocomplete-results" role="listbox" aria-label="Existing locations" data-location-suggestions-target="results" hidden>
          <% @location_suggestions.each_with_index do |location, index| %>
            <button type="button" id="flight-location-option-<%= index %>" class="exds-browser-autocomplete-option" role="option" aria-selected="false" tabindex="-1" data-location-suggestions-target="option" data-action="mousedown->location-suggestions#keepFocus click->location-suggestions#select"><%= location %></button>
          <% end %>
        </div>
      </div>
      <small id="flight-location-help" class="exds-browser-autocomplete-help">Select an existing location or enter a new one.</small>
      <span class="sr-only" role="status" aria-live="polite" data-location-suggestions-target="status"></span>
    </div>
    <label class="exds-browser-field is-wide">
      <span>Description (optional)</span>
      <%= form.text_field :description, placeholder: "Canopy handling test" %>
    </label>
    <% if flight.new_record? %>
      <div class="exds-browser-field is-wide exds-comment-editor" data-controller="flight-comments">
        <label class="exds-browser-field exds-comment-editor-field">
          <span>Comment (optional)</span>
          <%= form.text_area :initial_comment, rows: 5, maxlength: FlightComment::MAX_LENGTH, placeholder: "Observations, conditions and anything to remember…" %>
        </label>
        <%= render "flight_comments/image_upload", form: form, field: :initial_comment_images, field_id: "initial_comment", errors: flight.errors.any? %>
      </div>
    <% end %>
  </div>

  <fieldset class="exds-browser-fieldset">
    <legend>Equipment (optional)</legend>
    <div class="exds-browser-form-grid">
      <label class="exds-browser-field">
        <span>Aircraft</span>
        <%= form.collection_select :aircraft_id, @aircraft, :id, :display_name, { include_blank: "None" } %>
      </label>
      <label class="exds-browser-field">
        <span>FDR</span>
        <%= form.collection_select :fdr_id, @fdrs, :id, :display_name, { include_blank: "None" }, aria: { describedby: "flight-fdr-help" } %>
      </label>
    </div>
    <p class="operations-help" id="flight-fdr-help">Link an FDR to enable recording imports and telemetry. You can add one later.</p>
  </fieldset>

  <details class="exds-browser-fieldset exds-disclosure">
    <summary>Organization &amp; access</summary>
    <div class="exds-browser-field"><%= render "flights/folder_field", form: form %></div>
    <div class="exds-browser-field"><%= render "flights/visibility_field", form: form %></div>
  </details>

  <div class="exds-browser-form-actions">
    <%= link_to "Cancel", browser_path(selected: (browser_key(flight) if flight.persisted?)), class: "button-secondary exds-btn exds-btn--secondary", data: { turbo_frame: "flight-browser" } %>
    <%= form.submit @logging_preparation || (flight.new_record? && !preparation) ? "Log flight" : (flight.persisted? ? "Save flight" : "Create flight"), class: "button-primary exds-btn exds-btn--primary" %>
  </div>
<% end %>
