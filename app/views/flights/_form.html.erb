<%= form_with model: flight, class: "exds-browser-form", data: { turbo_frame: "flight-browser" } do |form| %>
  <%= hidden_field_tag :return_to_browser, "1", id: nil %>
  <% browser_context.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
  <% if flight.errors.any? %>
    <div class="workspace-errors" role="alert"><%= flight.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="exds-browser-form-grid">
    <label class="exds-browser-field">
      <span>Date *</span>
      <%= form.date_field :flown_on, value: flight.flown_on || (flight.display_flown_on unless flight.errors[:flown_on].any?), required: true %>
    </label>
    <label class="exds-browser-field">
      <span>Time (optional)</span>
      <%= form.time_field :flown_at %>
    </label>
    <label class="exds-browser-field is-wide">
      <span>Location *</span>
      <%= form.text_field :location, required: true, placeholder: "Airfield, drop zone or operating location" %>
    </label>
    <label class="exds-browser-field is-wide">
      <span>Description (optional)</span>
      <%= form.text_field :description, placeholder: "Canopy handling test" %>
    </label>
    <% if flight.new_record? %>
      <label class="exds-browser-field is-wide">
        <span>Comment (optional)</span>
        <%= form.text_area :initial_comment, rows: 5, maxlength: FlightComment::MAX_LENGTH, placeholder: "Observations, conditions and anything to remember…" %>
      </label>
    <% end %>
  </div>

  <fieldset class="exds-browser-fieldset">
    <legend>Equipment (optional)</legend>
    <div class="exds-browser-form-grid">
      <label class="exds-browser-field">
        <span>Aircraft</span>
        <%= form.collection_select :aircraft_id, @aircraft, :id, :display_name, { include_blank: "None" } %>
      </label>
      <label class="exds-browser-field">
        <span>FDR</span>
        <%= form.collection_select :fdr_id, @fdrs, :id, :display_name, { include_blank: "None" }, aria: { describedby: "flight-fdr-help" } %>
      </label>
    </div>
    <p class="operations-help" id="flight-fdr-help">Link an FDR to enable recording imports and telemetry. You can add one later.</p>
  </fieldset>

  <details class="exds-browser-fieldset">
    <summary>Organization &amp; access</summary>
    <div class="exds-browser-field"><%= render "flights/folder_field", form: form %></div>
    <div class="exds-browser-field"><%= render "flights/visibility_field", form: form %></div>
  </details>

  <div class="exds-browser-form-actions">
    <%= link_to "Cancel", browser_path(selected: (browser_key(flight) if flight.persisted?)), class: "button-secondary", data: { turbo_frame: "flight-browser" } %>
    <%= form.submit flight.persisted? ? "Save flight" : "Create flight", class: "button-primary" %>
  </div>
<% end %>
