<%= form_with model: flight, class: "operations-form" do |form| %>
  <% if flight.errors.any? %>
    <div class="workspace-errors"><%= flight.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="operations-form-grid">
    <label class="is-wide">
      <span>Flight name</span>
      <%= form.text_field :name, required: true, placeholder: "Prepared flight" %>
    </label>
    <label>
      <span>Aircraft</span>
      <%= form.collection_select :aircraft_id, @aircraft, :id, :display_name, { prompt: "Select aircraft" }, required: true %>
    </label>
    <label>
      <span>Landing zone</span>
      <%= form.collection_select :landing_zone_id, @landing_zones, :id, :name, { prompt: "Select landing zone" }, required: true %>
    </label>
    <label class="is-wide">
      <span>Notes</span>
      <%= form.text_area :notes, rows: 5, placeholder: "Operational context, crew, configuration…" %>
    </label>
  </div>

  <p class="operations-help">The flight starts in Preparation. Attach FlySight or ExoFDR data later, or open a linked Signal session.</p>
  <div class="operations-form-actions">
    <%= link_to "Cancel", flights_path, class: "button-secondary" %>
    <%= form.submit flight.persisted? ? "Save flight" : "Create in Preparation", class: "button-primary" %>
  </div>
<% end %>
