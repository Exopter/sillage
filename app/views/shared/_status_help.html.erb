<div data-controller="tooltip"
     data-action="mouseleave->tooltip#leave focusin->tooltip#show focusout->tooltip#blur keydown.esc@window->tooltip#hide resize@window->tooltip#position scroll@window->tooltip#position">
  <span id="<%= id %>-label"><%= label %></span>
  <% if local_assigns[:href] %>
    <%= link_to href, class: "workspace-help-trigger", data: { tooltip_target: "trigger", action: "mouseenter->tooltip#show" }, aria: { label: "Run preflight check", describedby: id } do %><strong data-signal-workspace-target="<%= status_target %>" data-state="unknown"><%= initial_status %></strong><% end %>
  <% else %>
    <button type="button" class="workspace-help-trigger" data-tooltip-target="trigger" data-action="mouseenter->tooltip#show click->tooltip#show" aria-labelledby="<%= id %>-label <%= id %>-value" aria-describedby="<%= id %>">
      <strong id="<%= id %>-value" data-signal-workspace-target="<%= status_target %>" data-state="unknown"><%= initial_status %></strong>
    </button>
  <% end %>
  <div id="<%= id %>" class="workspace-help-tooltip" role="tooltip" popover="manual" data-tooltip-target="tip">
    <b><%= label %></b>
    <span data-signal-workspace-target="<%= detail_target %>"><%= initial_detail %></span>
  </div>
</div>
