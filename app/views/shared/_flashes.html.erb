<% if flash.any? %>
  <div class="sillage-flashes" aria-label="Notifications">
    <% flash.each do |type, message| %>
      <% alert = type.to_s == "alert" %>
      <div class="flash <%= type %>" role="<%= alert ? "alert" : "status" %>" data-controller="flash" data-flash-timeout-value="<%= alert ? 0 : 5000 %>">
        <span class="flash-icon"><%= sillage_icon(alert ? "triangle-alert" : "circle-check", size: 17) %></span>
        <span class="flash-message"><%= message %></span>
        <button type="button" class="flash-dismiss" aria-label="Dismiss notification" data-action="flash#dismiss"><%= sillage_icon "x", size: 15 %></button>
      </div>
    <% end %>
  </div>
<% end %>
