<% if @page > 1 || @next_page %>
  <nav class="workspace-actions" aria-label="Pagination">
    <% if @page > 1 %><%= link_to "Previous", local_assigns[:path] ? path.call(@page - 1) : url_for(request.query_parameters.merge(page: @page - 1)), class: "button-secondary", rel: "prev" %><% end %>
    <span class="workspace-muted">Page <%= @page %></span>
    <% if @next_page %><%= link_to "Next", local_assigns[:path] ? path.call(@next_page) : url_for(request.query_parameters.merge(page: @next_page)), class: "button-secondary", rel: "next" %><% end %>
  </nav>
<% end %>
