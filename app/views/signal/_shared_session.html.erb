<div class="signal-home ex-dark"><div class="signal-home-inner">
<section class="signal-launch-card" data-controller="shared-flight" data-shared-flight-url-value="<%= shared_state_api_v1_signal_session_path(session.uuid) %>" data-shared-flight-close-value="<%= close_disconnected_api_v1_signal_session_path(session.uuid) %>" data-shared-flight-stop-value="<%= request_stop_api_v1_signal_session_path(session.uuid) %>">
  <div class="signal-launch-body">
    <h1><%= session.flight&.code || "Unassigned acquisition" %> · Shared flight</h1>
    <p data-shared-flight-target="status" role="status">Connecting…</p>
    <pre data-shared-flight-target="telemetry" aria-label="Latest telemetry"></pre>
    <button class="exds-btn exds-btn--danger" data-action="shared-flight#stop">End session</button>
    <button class="exds-btn exds-btn--secondary" data-action="shared-flight#closeDisconnected">Close disconnected session</button>
    <span data-shared-flight-target="flightLink">
      <% if session.flight %><%= link_to "Open flight and debrief", flight_path(session.flight), class: "exds-btn exds-btn--primary" %><% end %>
    </span>
    <%= link_to "Open acquisition station", signal_path(session: session.uuid), class: "exds-btn exds-btn--secondary" %>
    <label>Join on another device<input class="exds-input" readonly value="<%= signal_url(session: session.uuid, join: 1) %>"></label>
  </div>
</section>

</div></div>
