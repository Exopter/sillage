<div class="signal-home-link" data-controller="signal-radio-status" data-state="offline">
  <div class="signal-home-link-state" role="status" aria-live="polite">
    <%= sillage_icon "radio", size: 18 %>
    <div><strong data-signal-radio-status-target="label">No aircraft connected</strong><small data-signal-radio-status-target="detail">Connect the ground radio to check the aircraft.</small></div>
  </div>
  <button type="button" class="exds-btn exds-btn--secondary" data-signal-radio-status-target="button" data-action="signal-radio-status#toggle">Connect radio</button>
  <button type="button" class="exds-btn exds-btn--secondary" data-signal-radio-status-target="modeButton" data-action="signal-radio-status#changeMode" data-mode="ground" hidden>Ground mode (Wi-Fi)</button>
  <button type="button" class="exds-btn exds-btn--secondary" data-signal-radio-status-target="modeButton" data-action="signal-radio-status#changeMode" data-mode="flight" hidden>Flight mode</button>
  <button type="button" class="exds-btn exds-btn--secondary" data-signal-radio-status-target="assignButton" data-action="signal-radio-status#openAssignment" hidden>Assign to assembly</button>
  <%= render "signal/recorder_assignment" %>
</div>
