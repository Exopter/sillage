<% content_for :title, @active_session ? @active_session.flight.code : "Signal sessions" %>

<% if @active_session %>
  <% flight = @active_session.flight %>
  <div class="signal-root"
       data-controller="signal-workspace"
       data-signal-workspace-session-value="<%= @active_session.uuid %>"
       data-signal-workspace-flight-code-value="<%= flight.code %>"
       data-signal-workspace-batch-url-value="<%= batches_api_v1_signal_session_path(@active_session.uuid) %>"
       data-signal-workspace-event-url-value="<%= events_api_v1_signal_session_path(@active_session.uuid) %>"
       data-signal-workspace-complete-url-value="<%= complete_api_v1_signal_session_path(@active_session.uuid) %>"
       data-signal-workspace-map-image-url-value="<%= asset_path("landing-zone-terrain-v1.png") %>"
       data-signal-workspace-landing-zone-value="<%= flight.display_landing_zone %>">
    <div class="signal-live-shell" data-signal-workspace-target="presentation">
      <header class="signal-command-bar">
        <div class="signal-session-identity">
          <span class="signal-k">Flight</span>
          <strong><%= flight.code %></strong>
          <small><%= flight.display_aircraft %> · <%= flight.display_landing_zone %></small>
        </div>
        <div class="signal-link-stack" aria-label="Signal link status">
          <div><span>Radio</span><strong data-signal-workspace-target="radioStatus">Waiting for station</strong></div>
          <div><span>Recorder</span><strong data-signal-workspace-target="recorderStatus">Preparing local capture</strong></div>
          <div><span>Cloud</span><strong data-signal-workspace-target="cloudStatus">Live</strong></div>
        </div>
        <div class="signal-command-actions">
          <button type="button" class="signal-tool-button is-primary" aria-label="Connect station" data-action="signal-workspace#connectStation" data-signal-workspace-target="connectButton"><%= sillage_icon "radio", size: 14 %><span>Connect station</span></button>
          <button type="button" class="signal-tool-button" aria-label="Full screen" data-action="signal-workspace#toggleFullscreen"><%= sillage_icon "arrow-up-right", size: 14 %><span>Full screen</span></button>
          <button type="button" class="signal-tool-button" aria-label="Reset layout" data-action="signal-workspace#resetLayout"><%= sillage_icon "rotate-ccw", size: 14 %><span>Reset layout</span></button>
          <button type="button" class="signal-tool-button" aria-label="Mark event" data-action="signal-workspace#markEvent"><%= sillage_icon "plus", size: 14 %><span>Mark event</span></button>
          <button type="button" class="signal-tool-button is-danger" data-action="signal-workspace#endSession">End session</button>
        </div>
      </header>

      <div class="signal-storage-warning" data-signal-workspace-target="warning" hidden></div>

      <main class="signal-dashboard" data-signal-workspace-target="board" aria-label="Movable live Signal widgets">
        <section class="signal-widget" data-signal-workspace-target="widget" data-widget="map" data-mode="large">
          <header class="signal-widget-head">
            <button type="button" class="signal-drag-handle" aria-label="Move Live map" title="Drag to move · arrow keys to nudge" data-action="pointerdown->signal-workspace#startDrag keydown->signal-workspace#nudgeWidget dblclick->signal-workspace#resetWidget"><%= sillage_icon "menu", size: 13 %></button>
            <span class="signal-head-icon"><%= sillage_icon "map", size: 15 %></span><strong>Live map</strong><span class="signal-widget-subtitle">Flight path, heading and landing zone</span>
            <span class="signal-live-badge">Live</span>
            <span class="signal-mode-buttons"><%= render "signal/widget_modes" %></span>
          </header>
          <div class="signal-widget-body signal-map-body" style="--signal-map-image: url('<%= asset_path("landing-zone-terrain-v1.png") %>')">
            <canvas data-signal-workspace-target="mapCanvas" aria-label="Live flight path and heading"></canvas>
            <div class="signal-aircraft" data-signal-workspace-target="aircraftMarker"><span class="signal-heading-ray"></span><span class="signal-aircraft-icon"><%= sillage_icon "plane", size: 23, stroke_width: 1.8 %></span><span class="signal-aircraft-label"><strong><%= flight.code %> · LIVE</strong><small data-signal-workspace-target="aircraftLabel">Waiting for telemetry</small></span></div>
            <div class="signal-lz-marker"><span><%= sillage_icon "crosshair", size: 22 %></span><strong>Landing zone · <%= flight.display_landing_zone %></strong></div>
            <div class="signal-map-cache">Terrain available in this session</div>
            <div class="signal-map-event" data-signal-workspace-target="latestEvent" hidden></div>
          </div>
        </section>

        <section class="signal-widget" data-signal-workspace-target="widget" data-widget="instruments" data-mode="mini">
          <header class="signal-widget-head">
            <button type="button" class="signal-drag-handle" aria-label="Move Instruments" title="Drag to move · arrow keys to nudge" data-action="pointerdown->signal-workspace#startDrag keydown->signal-workspace#nudgeWidget dblclick->signal-workspace#resetWidget"><%= sillage_icon "menu", size: 13 %></button>
            <span class="signal-head-icon"><%= sillage_icon "gauge", size: 15 %></span><strong>Instruments</strong><span class="signal-widget-subtitle">Ground-reconstructed flight state</span>
            <span class="signal-live-badge">Live</span>
            <span class="signal-mode-buttons"><%= render "signal/widget_modes" %></span>
          </header>
          <div class="signal-widget-body"><canvas class="signal-instrument-canvas" data-signal-workspace-target="instrumentCanvas" aria-label="Ground reconstructed instruments"></canvas></div>
        </section>

        <section class="signal-widget" data-signal-workspace-target="widget" data-widget="charts" data-mode="mini">
          <header class="signal-widget-head">
            <button type="button" class="signal-drag-handle" aria-label="Move Charts" title="Drag to move · arrow keys to nudge" data-action="pointerdown->signal-workspace#startDrag keydown->signal-workspace#nudgeWidget dblclick->signal-workspace#resetWidget"><%= sillage_icon "menu", size: 13 %></button>
            <span class="signal-head-icon"><%= sillage_icon "activity", size: 15 %></span><strong>Charts</strong><span class="signal-widget-subtitle">Aligned telemetry and stream validity</span>
            <span class="signal-live-badge">Live</span>
            <span class="signal-mode-buttons"><%= render "signal/widget_modes" %></span>
          </header>
          <div class="signal-widget-body"><canvas class="signal-chart-canvas" data-signal-workspace-target="chartCanvas" aria-label="Aligned telemetry charts"></canvas></div>
        </section>
      </main>

      <footer class="signal-telemetry-strip" aria-label="Shared live telemetry">
        <div><span>Heading</span><strong data-signal-workspace-target="heading">---</strong><small>deg</small></div>
        <div><span>Airspeed</span><strong data-signal-workspace-target="airspeed">---</strong><small>km/h</small></div>
        <div><span>Altitude</span><strong data-signal-workspace-target="altitude">---</strong><small>m AMSL</small></div>
        <div><span>Vertical speed</span><strong data-signal-workspace-target="verticalSpeed">---</strong><small>m/s</small></div>
        <div><span>Glide</span><strong data-signal-workspace-target="glide">---</strong><small>L/D</small></div>
        <div class="signal-telemetry-health"><span>Data</span><strong data-signal-workspace-target="dataStatus">Waiting for telemetry</strong><small data-signal-workspace-target="parserStatus">No valid MAVLink frames</small></div>
      </footer>
    </div>
  </div>
<% else %>
  <div class="signal-home">
    <div class="signal-home-inner">
      <header class="signal-home-head">
        <div><span class="signal-k">Sillage Signal</span><h1>Start live acquisition</h1><p>Connect the ground radio, display telemetry and record a durable local capture while the cloud stays synchronized.</p></div>
      </header>
      <div class="signal-launch-grid">
        <section class="signal-launch-card">
          <div class="signal-launch-body"><span class="signal-k">Prepared flights</span><h2>Attach to an existing flight</h2><p>The aircraft, landing zone and Hangar configuration are inherited automatically.</p></div>
          <% @preparation_flights.each do |flight| %>
            <div class="signal-prep-row">
              <div><strong><%= flight.code %></strong><span><%= flight.display_aircraft %> · <%= flight.display_landing_zone %></span></div>
              <%= button_to "Open session", signal_sessions_path(flight_id: flight.id), class: "signal-tool-button is-primary", form: { data: { turbo: false } } %>
            </div>
          <% end %>
          <% if @preparation_flights.empty? %><div class="signal-prep-empty">No flight is currently in Preparation.</div><% end %>
        </section>
        <section class="signal-launch-card">
          <div class="signal-launch-body">
            <span class="signal-k">Direct acquisition</span><h2>Create from Signal</h2><p>A new Flight is created. Aircraft and landing zone are filled automatically when identification is unambiguous; otherwise they remain To complete.</p>
            <%= button_to signal_sessions_path, class: "signal-tool-button is-primary signal-start-direct", form: { data: { turbo: false } } do %><%= sillage_icon "radio", size: 15 %><span>Start unassigned session</span><% end %>
            <div class="signal-launch-rules"><div><%= sillage_icon "download", size: 15 %><span><strong>Local capture first</strong>Raw MAVLink continues during a brief Internet cut.</span></div><div><%= sillage_icon "upload", size: 15 %><span><strong>Automatic recovery</strong>Queued batches resume from the last acknowledgement.</span></div><div><%= sillage_icon "shield", size: 15 %><span><strong>microSD authoritative</strong>Signal complements the onboard recorder.</span></div></div>
          </div>
        </section>
      </div>
    </div>
  </div>
<% end %>
