<% flight = @active_session&.flight %>
<% content_for :title, @active_session ? flight&.code || "Flight" : "Signal" %>
<% content_for :connection_metrics do %>
  <%= render "signal/module_status" %>
  <%= render "signal/radio_quality" %>
<% end %>
<% content_for :rail_control do %>
  <button type="button" class="exds-iconbtn--edge sillage-rail-toggle panel-disclosure" aria-label="Hide navigation" aria-controls="sillage-room-rail" aria-expanded="true"
          data-controller="panel-disclosure" data-action="panel-disclosure#toggle"
          data-panel-disclosure-storage-key-value="signal-navigation" data-panel-disclosure-expand-label-value="Show navigation" data-panel-disclosure-collapse-label-value="Hide navigation">
    <%= sillage_icon "chevron-right", size: 12 %>
  </button>
<% end %>
<% content_for :connection_control do %>
  <%= render "signal/link_control" %>
<% end %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <link rel="stylesheet" href="<%= Rails.application.config.x.cesium_base_url %>Widgets/widgets.css">
<% end %>

<%# One workspace for both states: standby keeps the link open and shows live telemetry without recording it. %>
<div class="signal-root ex-dark" data-signal-environment="<%= @environment %>"
     data-controller="signal-workspace"
     data-signal-workspace-cesium-token-value="<%= @cesium_ion_token %>"
     data-signal-workspace-cesium-base-url-value="<%= Rails.application.config.x.cesium_base_url %>"
     data-signal-workspace-mount-profiles-value="<%= @imu_mount_profiles.to_json %>"
     data-signal-workspace-home-url-value="<%= signal_path(view: "home") %>"
     <% if @active_session %>
       data-signal-workspace-review-value="<%= params[:review] == "1" %>"
       data-signal-workspace-completed-value="<%= @active_session.status == "completed" %>"
       data-signal-workspace-session-value="<%= @active_session.uuid %>"
       data-signal-workspace-recorder-device-id-value="<%= @active_session.station_metadata["recorder_device_id"] %>"
       data-signal-workspace-recorder-assembly-id-value="<%= @active_session.station_metadata["recorder_assembly_id"] %>"
       data-signal-workspace-flight-id-value="<%= flight&.id %>"
       data-signal-workspace-flight-code-value="<%= flight&.code || "UNASSIGNED" %>"
       data-signal-workspace-batch-url-value="<%= batches_api_v1_signal_session_path(@active_session.uuid) %>"
       data-signal-workspace-event-url-value="<%= events_api_v1_signal_session_path(@active_session.uuid) %>"
       data-signal-workspace-complete-url-value="<%= complete_api_v1_signal_session_path(@active_session.uuid) %>"
       data-action="sillage:signal-glide-ratio@window->signal-workspace#setGlideRatio"
     <% else %>
       data-signal-workspace-flight-code-value="STANDBY"
       data-action="sillage:signal-start@window->signal-workspace#startFlight sillage:signal-identity-changed@window->signal-workspace#refreshIdentity sillage:signal-glide-ratio@window->signal-workspace#setGlideRatio"
     <% end %>>
  <% if @active_session %>
    <%= render "signal/exit_dialog", flight: flight %>
  <% end %>
  <div class="signal-live-shell">
    <header class="signal-command-bar" data-signal-state="<%= @active_session ? "recording" : "standby" %>">
      <div class="signal-session-identity">
        <% if @active_session %>
          <span class="signal-k signal-recording-label">Recording · <%= flight&.code || "Flight" %> · <%= @environment.capitalize %></span>
          <small><%= flight&.display_aircraft || "No aircraft" %></small>
        <% else %>
          <span class="signal-k">Signal <%= @environment.capitalize %> · Standby · Not recording</span>
          <small data-signal-workspace-target="standbyAircraft">No aircraft heard</small>
        <% end %>
        <small data-signal-workspace-target="mountLabel">Waiting for recorder mounting</small>
      </div>
      <div class="signal-link-stack" aria-label="Signal link status">
        <div><span>Link</span><strong data-signal-workspace-target="radioStatus">Not connected</strong></div>
        <% if @active_session %>
          <div><span>Capture</span><strong data-signal-workspace-target="recorderStatus">Not recording</strong></div>
          <div><span>Cloud</span><strong data-signal-workspace-target="cloudStatus">Preparing</strong></div>
        <% else %>
          <div><span>Aircraft</span><strong data-signal-workspace-target="aircraftStatus">Waiting for the link</strong></div>
          <div><span>Flight</span><strong data-signal-workspace-target="recorderStatus">Not recording</strong></div>
        <% end %>
      </div>
      <div class="signal-link-stack signal-quality-stack" aria-label="Live IMU quality" data-tooltip-boundary>
        <%= render "shared/status_help", id: "signal-attitude-detail", label: "Attitude", status_target: "qualityAttitude", detail_target: "attitudeDetail", initial_status: "Unknown", initial_detail: "Waiting for IMU quality telemetry." %>
        <%= render "shared/status_help", id: "signal-heading-detail", label: "Heading", status_target: "qualityHeading", detail_target: "headingDetail", initial_status: "Unknown", initial_detail: "Waiting for heading quality telemetry." %>
        <%= render "shared/status_help", id: "signal-preflight-detail", label: "Preflight", status_target: "preflightStatus", detail_target: "preflightDetail", initial_status: "Not checked", initial_detail: "No preflight check is available.", href: flight ? flight_imu_check_path(flight) : nil %>
      </div>
      <div class="signal-command-actions">
        <% if @active_session %>
          <button type="button" class="signal-tool-button exds-btn exds-btn--secondary" aria-label="Mark event" data-action="signal-workspace#markEvent"><%= sillage_icon "plus", size: 14 %><span>Mark event</span></button>
          <button type="button" class="signal-tool-button exds-btn exds-btn--danger is-danger" data-action="signal-workspace#endSession">End flight</button>
        <% else %>
          <%# A distributed Seat changes mode only on a command signed with its Sillage key. %>
          <button type="button" class="signal-tool-button exds-btn exds-btn--secondary" data-signal-workspace-target="modeButton" data-action="signal-workspace#changeMode" data-mode="ground" hidden><%= sillage_icon "wifi", size: 14 %><span>Ground mode (Wi-Fi)</span></button>
          <button type="button" class="signal-tool-button exds-btn exds-btn--secondary" data-signal-workspace-target="modeButton" data-action="signal-workspace#changeMode" data-mode="flight" hidden><%= sillage_icon "plane", size: 14 %><span>Flight mode</span></button>
          <nav class="signal-mode-buttons signal-environment" aria-label="Signal mode">
            <% Flight::ENVIRONMENTS.reverse_each do |value| %>
              <%= link_to value.capitalize, signal_path(view: "home", environment: value, flight_id: @selected_flight&.id), aria: { current: ("true" if @environment == value) }, data: { turbo: false } %>
            <% end %>
          </nav>
          <%= render "signal/remote_switch" %>
          <%= form_with url: signal_sessions_path, class: "signal-start", data: { signal_workspace_target: "startForm" } do |form| %>
            <%= form.hidden_field :device_id, value: "", id: nil, data: { signal_workspace_target: "startDevice" } %>
            <%= form.hidden_field :transport, value: "", id: nil, data: { signal_workspace_target: "startTransport" } %>
            <%= form.hidden_field :environment, value: @environment, id: nil %>
            <%= form.hidden_field :tunnel_glide_ratio, value: "", id: nil, data: { signal_workspace_target: "startGlideRatio" } %>
            <span class="exds-selection-field">
              <%= form.select :flight_id, options_for_select([ [ "New flight", "" ] ] + @prepared_flights.map { |prepared| [ "#{prepared.code} · #{prepared.display_aircraft}", prepared.id ] }, @selected_flight&.id),
                    {}, id: nil, class: "exds-select", aria: { label: "Flight to record" }, data: { signal_workspace_target: "startFlight" } %>
            </span>
            <button type="button" class="signal-tool-button exds-btn exds-btn--primary is-primary" disabled aria-describedby="signal-start-hint"
                    data-signal-workspace-target="startButton" data-action="signal-workspace#startFlight"><%= sillage_icon "play", size: 14 %><span>Start flight</span></button>
          <% end %>
        <% end %>
      </div>
    </header>

    <% unless @active_session %>
      <p id="signal-start-hint" class="signal-standby-hint" role="status" data-signal-workspace-target="startHint">Connect the link to hear the aircraft.</p>
      <%= render "signal/standby_notices" %>
    <% end %>
    <%= render "signal/dashboard", code: flight&.code || (@active_session ? "Flight" : "Standby"), environment: @environment, glide_ratio: flight&.tunnel_glide_ratio %>
  </div>
</div>
