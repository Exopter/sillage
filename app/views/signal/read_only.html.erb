<% content_for :title, "Signal" %>
<header class="workspace-header">
  <div><span class="section-eyebrow">Signal</span><h1>Sessions</h1><p>Read-only access. Administrators manage acquisition and connected equipment.</p></div>
  <%= link_to "Refresh", signal_path(session: @active_session&.uuid), class: "button-secondary" %>
</header>
<% if @active_session %>
  <section class="workspace-panel" aria-label="Selected Signal session">
    <h2><%= @active_session.flight&.code || "Unassigned session" %></h2>
    <dl class="workspace-details">
      <div><dt>Status</dt><dd><%= @active_session.status.humanize %></dd></div>
      <div><dt>Started</dt><dd><%= l @active_session.started_at, format: :long %></dd></div>
      <div><dt>Ended</dt><dd><%= @active_session.ended_at ? l(@active_session.ended_at, format: :long) : "Session in progress" %></dd></div>
      <div><dt>Received batches</dt><dd><%= @active_session.signal_batches.count %></dd></div>
    </dl>
    <div class="workspace-actions">
      <% if @active_session.flight %><%= link_to "Open flight", flight_path(@active_session.flight), class: "button-secondary" %><% end %>
      <%= link_to "Radio history", signal_session_radio_history_path(@active_session.uuid), class: "button-secondary" %>
      <% if @active_session.raw_capture.attached? %><%= link_to "Download capture", attachment_path(@active_session.raw_capture.attachment), class: "button-secondary" %><% end %>
    </div>
  </section>
<% end %>
<section class="workspace-panel">
  <h2>Accessible sessions</h2>
  <% if @read_only_sessions.any? %>
    <div class="workspace-table-wrap"><table class="workspace-table">
      <thead><tr><th>Flight</th><th>Started</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody><% @read_only_sessions.each do |session| %><tr>
        <td><%= session.flight&.code || "Unassigned session" %></td>
        <td><%= l session.started_at, format: :short %></td><td><%= session.status.humanize %></td>
        <td><%= link_to "View session", signal_path(session: session.uuid), class: "workspace-strong-link" %> · <%= link_to "Radio history", signal_session_radio_history_path(session.uuid), class: "workspace-strong-link" %></td>
      </tr><% end %></tbody>
    </table></div>
  <% else %><p class="workspace-empty">No accessible sessions.</p><% end %>
</section>
