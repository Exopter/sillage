<%# With the remote on, this computer starts and ends flights when a phone asks. %>
<div class="signal-remote" data-controller="signal-station" data-signal-station-url-value="<%= remote_station_path %>"
     data-signal-station-environment-value="<%= @environment %>"
     data-action="sillage:signal-standby@window->signal-station#standby sillage:signal-glide-ratio@window->signal-station#glideRatio">
  <button type="button" class="signal-tool-button exds-btn exds-btn--secondary" aria-pressed="false"
          data-signal-station-target="toggle" data-action="signal-station#toggle"><%= sillage_icon "smartphone", size: 14 %><span data-signal-station-target="label">Phone remote off</span></button>
  <button type="button" class="signal-tool-button exds-btn exds-btn--secondary" aria-label="Show the remote QR code" title="Show the remote QR code"
          data-signal-station-target="pair" data-action="signal-station#showPairing" hidden><%= sillage_icon "qr-code", size: 14 %></button>
  <dialog class="workspace-dialog ex-dark" data-signal-station-target="dialog" aria-labelledby="signal-remote-title">
    <div class="workspace-dialog-head">
      <h3 id="signal-remote-title">Phone remote</h3>
      <button type="button" class="exds-iconbtn exds-iconbtn--ghost" aria-label="Close" data-action="signal-station#closePairing"><%= sillage_icon "x", size: 16 %></button>
    </div>
    <div class="workspace-dialog-section signal-remote-pairing">
      <%= image_tag @remote_qr, alt: "QR code opening the remote", class: "signal-remote-qr", width: 200, height: 200 %>
      <div>
        <p>Scan with the phone that starts and ends the flights. This computer records each one while Signal stays open here with the aircraft heard.</p>
        <p class="operations-help" role="status" data-signal-station-target="status">The remote is off.</p>
        <%= link_to "Open the remote on this device", remote_path, class: "workspace-strong-link" %>
      </div>
    </div>
  </dialog>
</div>
