<% replacing = local_assigns[:replacing] %>
<% unless flight.live? %>
<section id="<%= dom_id(flight, :debrief) %>" class="exds-browser-editor-section flight-debrief" aria-labelledby="<%= dom_id(flight, :debrief_title) %>" data-controller="flight-debrief" data-flight-debrief-url-value="<%= flight_debriefs_path(flight) %>" data-flight-debrief-key-value="<%= Current.user.id %>:<%= flight.id %>" data-flight-debrief-comments-url-value="<%= flight_comments_path(flight) %>"<% if replacing %> data-flight-debrief-replaces-value="<%= replacing.id %>"<% end %>>
  <header class="flight-debrief-head">
    <div><span class="flight-debrief-eyebrow">Pilot log</span><h3 id="<%= dom_id(flight, :debrief_title) %>"><%= replacing ? "Record the debrief again" : "Debrief your flight" %></h3></div>
    <ol class="flight-debrief-steps" aria-label="Debrief steps"><li>Record</li><li>Save</li><li>Pilot log</li></ol>
  </header>

  <div class="flight-debrief-stage">
    <button type="button" class="flight-debrief-record" data-debrief-states="idle" data-action="flight-debrief#start" aria-label="Record debrief" title="Record debrief"><%= sillage_icon "mic", size: 32, stroke_width: 1.8 %></button>
    <div class="flight-debrief-live" data-debrief-states="recording paused" hidden>
      <span class="flight-debrief-clock" data-flight-debrief-target="duration">0:00</span>
      <div class="flight-debrief-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <label class="sr-only">Microphone level <meter min="0" max="1" value="0" data-flight-debrief-target="level"></meter></label>
    </div>
    <span class="flight-debrief-spinner" data-debrief-states="busy" hidden aria-hidden="true"></span>
    <p class="flight-debrief-status" data-flight-debrief-target="status" role="status">Tap the microphone and talk. When you finish, the debrief goes straight to the Pilot Log and its summary follows.</p>
  </div>

  <div class="flight-debrief-actions">
  <button type="button" class="exds-btn exds-btn--secondary exds-btn--lg" data-debrief-states="recording paused" hidden data-action="flight-debrief#pause">Pause</button>
  <button type="button" class="exds-btn exds-btn--primary exds-btn--lg" data-debrief-states="recording paused" hidden data-action="flight-debrief#stop">Finish recording</button>
  <button type="button" class="exds-btn exds-btn--primary exds-btn--lg" data-debrief-states="recovery" hidden data-action="flight-debrief#recover">Recover saved recording</button>
  </div>

  <details class="exds-disclosure flight-debrief-transcript" data-debrief-states="recording paused" hidden><summary>Transcript</summary><p data-flight-debrief-target="transcript" aria-live="polite"></p></details>

  <div class="flight-debrief-actions">
  <button type="button" class="exds-btn exds-btn--danger" data-debrief-states="recovery" hidden data-action="flight-debrief#discard">Discard draft</button>
  </div>

  <% if replacing %>
    <p class="flight-debrief-note"><%= sillage_icon "refresh-cw", size: 14 %><span>The new recording replaces the current debrief once it is saved. <%= link_to "Keep the current debrief", flight_comments_path(flight) %></span></p>
  <% end %>
  <p class="flight-debrief-note"><%= sillage_icon "lock-keyhole", size: 14 %><span>Audio is saved on this device first, so a lost connection does not lose it. The original stays attached to the Pilot Log entry.</span></p>
</section>
<% else %>
<p>End the live session to record your audio debrief.</p>
<% end %>
