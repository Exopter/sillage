<% tone, label = hangar_asset_status(asset) %>
<div class="hangar-tree-row is-level-<%= [level, 3].min %>">
  <div class="hangar-tree-primary">
    <span class="hangar-tree-icon"><%= sillage_icon asset.is_a?(Assembly) ? "layers" : "settings", size: 15 %></span>
    <span class="hangar-tree-copy"><strong><%= hangar_asset_code asset %> · <%= hangar_asset_name asset %></strong><small><%= asset.is_a?(Part) ? "SN #{asset.serial_number.presence || "not recorded"}" : "#{pluralize asset.parts.size, "direct part"}" %></small></span>
  </div>
  <span class="hangar-kind"><%= hangar_asset_kind asset %></span>
  <span class="status-dot is-<%= tone %>"><span></span><%= label %></span>
</div>
<% if asset.is_a?(Assembly) %>
  <% asset.children.ordered.each do |child| %><%= render "hangar/aircraft/configuration_asset", asset: child, level: level + 1 %><% end %>
  <% asset.parts.includes(:function).ordered.each do |part| %><%= render "hangar/aircraft/configuration_asset", asset: part, level: level + 1 %><% end %>
<% end %>
