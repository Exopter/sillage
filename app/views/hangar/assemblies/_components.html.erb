<section class="workspace-panel">
  <div class="workspace-panel-header">
    <h2>Composition</h2>
    <div class="workspace-actions">
      <% unless @assembly.fdr_system? %>
        <%= render "hangar/picker", trigger: "Install part", icon: "plus", title: "Install in #{@assembly.display_name}", url: install_part_hangar_assembly_path(@assembly),
          options: hangar_part_options(@available_parts, field: "part_id"), empty: "No part in stock" %>
      <% end %>
      <% if @assembly.fdr_component_type.blank? || @assembly.fdr_system? %>
        <%= render "hangar/picker", trigger: "Attach subassembly", icon: "plus", title: "Attach to #{@assembly.display_name}", submit: "Attach", url: attach_assembly_hangar_assembly_path(@assembly),
          options: hangar_assembly_options(@available_assemblies, field: "child_id"), empty: "No free assembly" %>
      <% end %>
    </div>
  </div>
  <% parts = @assembly.fdr_system? ? [] : @assembly.parts.includes(:function).ordered.reject { |part| @assembly.controlled_fdr? && part.function.code == "CONTROLLER" } %>
  <% children = @assembly.children.ordered.to_a %>
  <% if parts.any? || children.any? %>
    <div class="workspace-list">
      <% parts.each do |part| %>
        <div class="workspace-list-row is-static">
          <span><strong><%= link_to part.display_name, hangar_part_path(part) %> · <%= part.function.name %></strong><small><%= part.serial_number.present? ? "S/N #{part.serial_number} · Asset ID #{part.internal_number}" : "Asset ID #{part.internal_number}" %><%= " · ECU ID #{ecu_label(part.embedded_controller.device_id)}" if part.embedded_controller&.device_id %></small></span>
          <div class="workspace-actions">
            <% replacements = @available_parts.select { |candidate| candidate.function_id == part.function_id } %>
            <% if replacements.any? %>
              <%= render "hangar/picker", trigger: "Replace", title: "Replace #{part.display_name}", submit: "Replace", method: :patch,
                url: replace_part_hangar_assembly_path(@assembly, part_id: part.id), options: hangar_part_options(replacements, field: "replacement_part_id") %>
            <% end %>
            <%= button_to "Take out", remove_part_hangar_assembly_path(@assembly, part_id: part.id), method: :delete, class: "button-secondary exds-btn exds-btn--secondary is-compact" %>
          </div>
        </div>
      <% end %>
      <% children.each do |child| %>
        <div class="workspace-list-row is-static">
          <span><strong><%= link_to child.selection_label, hangar_assembly_path(child) %></strong><small>Subassembly · <%= pluralize child.snapshot_part_numbers.size, "part" %></small></span>
          <%= button_to "Take out", detach_assembly_hangar_assembly_path(@assembly, child_id: child.id), method: :delete, class: "button-secondary exds-btn exds-btn--secondary is-compact" %>
        </div>
      <% end %>
    </div>
  <% else %><div class="workspace-empty">Nothing is installed in this assembly yet.</div><% end %>
</section>
