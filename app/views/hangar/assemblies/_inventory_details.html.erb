<%= turbo_frame_tag "assembly-details", data: { assembly_hierarchy_target: "frame" } do %>
  <% if node %>
    <% asset = node.asset; parents = @inventory.ancestors(node); location = @inventory.aircraft(node) %>
    <header class="hangar-panel-head"><span class="section-eyebrow"><%= node.assembly? ? "Assembly details" : "Part details" %></span></header>
    <div class="exds-hierarchy-path">
      <% if parents.any? %>
        <% parents.each_with_index do |parent, index| %><%= " / " if index.positive? %><%= link_to parent.label, hangar_assemblies_path(node: parent.key, state: @state), data: { turbo_frame: "assembly-details", action: "assembly-hierarchy#select", key: parent.key } %><% end %>
      <% else %><%= node.kind == "system" ? "SYSTEMS / Root assembly" : node.assembly? ? "Standalone / Root assembly" : "Part on its own" %><% end %>
    </div>
    <div class="hangar-details-body">
      <span class="section-eyebrow"><%= node.kind == "system" ? "Logical system" : node.assembly? ? node.subtitle : asset.function.name %></span>
      <h3><%= node.label %></h3>
      <% if asset.notes.present? %><p><%= asset.notes %></p><% end %>
      <% if node.kind == "system" %>
        <% modules = @inventory.child_assemblies(node) %>
        <div class="exds-hierarchy-overview"><div><strong><%= modules.size %> / 4</strong><span>Assigned module roles</span></div><div><strong><%= @inventory.part_count(node) %></strong><span>Parts across modules</span></div></div>
        <div class="exds-hierarchy-roles"><% Assembly::FDR_MODULE_TYPES.each do |role| %><% assigned = modules.any? { |child| child.asset.fdr_component_type == role } %><span class="<%= assigned ? "is-assigned" : "is-missing" %>"><%= Assembly::FDR_COMPONENT_TYPES.fetch(role) %><%= " · Missing" unless assigned %></span><% end %></div>
        <p class="exds-hierarchy-help">Composition only. Serviceability is tracked separately.</p>
      <% end %>
      <dl>
        <% if parents.any? %><div><dt><%= node.assembly? ? "Parent assembly" : "Assembly" %></dt><dd><%= parents.last.label %></dd></div><% end %>
        <% if node.parent_key.nil? %><div><dt>Aircraft</dt><dd><%= location ? link_to(location.registration, hangar_aircraft_path(location), data: { turbo_frame: "_top" }) : (node.assembly? ? "No aircraft assigned" : "In stock") %></dd></div><% end %>
        <div><dt><%= node.assembly? ? "Serviceability" : "State" %></dt><dd><%= node.assembly? ? asset.serviceability_label : asset.state.humanize %></dd></div>
        <% if node.assembly? %>
          <% if asset.controlled_fdr? %><div><dt>Functional configuration</dt><dd><%= asset.functional_configuration %></dd></div><% end %>
          <% unless node.kind == "system" %><div><dt>Direct parts</dt><dd><%= @inventory.direct_parts(node).size %></dd></div><% end %>
          <% if asset.controlled_fdr? && !asset.fdr_system? %><div><dt>Firmware</dt><dd><%= asset.embedded_controller&.last_seen_firmware.presence || "Not reported" %></dd></div><% end %>
        <% else %><div><dt>Serial number</dt><dd><%= asset.serial_number.presence || "Not recorded" %></dd></div><% end %>
        <div><dt>Internal Asset ID</dt><dd><%= asset.internal_number %></dd></div>
      </dl>
      <% back = hangar_assemblies_path(node: (parents.last || node).key, state: @state) %>
      <div class="workspace-actions">
        <%= link_to "Edit", node.assembly? ? edit_hangar_assembly_path(asset) : edit_hangar_part_path(asset), class: "button-secondary exds-btn exds-btn--secondary is-compact", data: { turbo_frame: "_top" } %>
        <% if !node.assembly? && parents.any? %>
          <% candidates = Part.available.includes(:function).where(function_id: asset.function_id).ordered %>
          <% if candidates.any? %>
            <%= render "hangar/picker", trigger: "Replace", title: "Replace #{asset.display_name}", submit: "Replace", method: :patch,
              url: replace_part_hangar_assembly_path(parents.last.asset, part_id: asset.id), hidden: { return_to: back },
              options: hangar_part_options(candidates, field: "replacement_part_id") %>
          <% end %>
          <%= button_to "Take out", remove_part_hangar_assembly_path(parents.last.asset, part_id: asset.id), method: :delete, params: { return_to: back },
            class: "button-secondary exds-btn exds-btn--secondary is-compact", form: { data: { turbo_frame: "_top", turbo_confirm: "Take #{asset.display_name} out of #{parents.last.label}?" } } %>
        <% elsif node.assembly? && !asset.fdr_system? && asset.serviceability_state != "retired" %>
          <%= render "hangar/picker", trigger: "Install part", title: "Install in #{node.label}", url: install_part_hangar_assembly_path(asset), hidden: { return_to: back },
            options: hangar_part_options(Part.available.includes(:function).ordered, field: "part_id"), empty: "No part in stock" %>
        <% end %>
        <%= link_to "Open full record", node.assembly? ? hangar_assembly_path(asset) : hangar_part_path(asset), class: "button-secondary exds-btn exds-btn--secondary is-compact", data: { turbo_frame: "_top" } %>
        <% if node.assembly? && asset.controlled_fdr? && !asset.fdr_system? && asset.serviceability_state != "retired" %><%= link_to "Open in Forge", forge_fdr_path(asset.serial_number), class: "button-secondary exds-btn exds-btn--secondary is-compact", data: { turbo_frame: "_top" } %><% end %>
      </div>
    </div>
    <% unless node.assembly? %>
      <% history = asset.part_installations.includes(:assembly).recent.to_a %>
      <details class="exds-disclosure hangar-fold">
        <summary><span>History</span><small><%= pluralize history.size, "installation" %></small></summary>
        <% if history.any? %>
          <div class="workspace-list">
            <% history.each do |installation| %>
              <div class="workspace-list-row is-static"><span><strong><%= installation.assembly.identity_label %></strong><small><%= l installation.installed_at, format: :short %> → <%= installation.removed_at ? l(installation.removed_at, format: :short) : "Active" %></small></span></div>
            <% end %>
          </div>
        <% else %><p class="workspace-muted">Never installed in an assembly.</p><% end %>
      </details>
    <% end %>
    <footer class="hangar-detail-note"><%= node.kind == "system" ? "A logical SYSTEMS assembly groups physical modules. Each module keeps its own serial number." : "Parts and nested Assemblies can be moved while their installation history remains traceable." %></footer>
  <% else %><p class="workspace-empty"><%= params[:node].present? || params[:assembly_id].present? ? "This item is no longer in the assembly inventory." : "Select an assembly or part to view its details." %></p><% end %>
<% end %>
