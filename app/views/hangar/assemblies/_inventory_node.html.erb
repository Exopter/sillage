<% location = @inventory.aircraft(node) %>
<div data-assembly-hierarchy-target="branch" data-key="<%= node.key %>" data-parent="<%= node.parent_key %>" data-kind="<%= node.kind %>" data-category="<%= category %>" data-search="<%= node.search %>">
  <div class="exds-hierarchy-row <%= "is-system" if node.kind == "system" %> <%= "is-part" unless node.assembly? %> <%= "is-selected" if node == @selected_node %>" style="--exds-hierarchy-depth:<%= depth %>" data-node-row>
    <div class="exds-hierarchy-primary <%= "is-nested" if depth.positive? %>">
      <% if node.children.any? %>
        <button class="exds-hierarchy-disclosure" type="button" aria-label="Collapse <%= node.label %>" aria-expanded="true" aria-controls="children-<%= node.key %>" data-label="<%= node.label %>" data-key="<%= node.key %>" data-action="assembly-hierarchy#toggle"><%= sillage_icon "chevron-right", size: 14 %></button>
      <% else %><span class="exds-hierarchy-disclosure-space"></span><% end %>
      <%= link_to hangar_assemblies_path(node: node.key, state: @state), class: "exds-hierarchy-select", aria: { current: ("true" if node == @selected_node) }, data: { turbo_frame: "assembly-details", action: "assembly-hierarchy#select", key: node.key } do %>
        <span class="exds-hierarchy-icon"><%= sillage_icon(node.assembly? ? "layers" : "wrench", size: 16) %></span>
        <span class="exds-hierarchy-copy"><strong><%= node.label %></strong><small><%= node.subtitle %><% if node.assembly? %> · <% if node.kind == "system" %><%= pluralize @inventory.child_assemblies(node).size, "module" %> · <% end %><%= pluralize @inventory.part_count(node), "part" %><% end %></small></span>
      <% end %>
    </div>
    <span class="exds-hierarchy-location"><%= location&.registration || "Not installed" %><% if node.parent_key && location %><small>Via parent</small><% end %></span>
  </div>
  <% if node.children.any? %>
    <div id="children-<%= node.key %>" data-node-children>
      <% node.children.each do |child| %><%= render "inventory_node", node: child, depth: depth + 1, category: %><% end %>
    </div>
  <% end %>
</div>
