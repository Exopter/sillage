<% content_for :title, @assembly.controlled_fdr? ? @assembly.serial_label : @assembly.name %>
<%= render "hangar/tabs" %>

<header class="workspace-header">
  <% if @assembly.controlled_fdr? %>
    <div><span class="section-eyebrow">Assembly</span><h2><%= @assembly.display_name %></h2></div>
  <% else %>
    <div><span class="section-eyebrow">Assembly</span><h2><%= @assembly.name %></h2><p>Asset ID <%= @assembly.internal_number %></p></div>
  <% end %>
  <div class="workspace-actions">
    <% if @assembly.controlled_fdr? && !@assembly.fdr_system? && @assembly.serviceability_state != "retired" %><%= link_to "Open in Forge", forge_fdr_path(@assembly.serial_number), class: "button-primary" %><% end %>
    <%= link_to "Edit", edit_hangar_assembly_path(@assembly), class: "button-secondary" %>
  </div>
</header>

<section class="workspace-panel">
  <div class="workspace-panel-header"><h2>Identity</h2><span><%= @assembly.fdr_system? ? "Logical system" : "Physical assembly" %></span></div>
  <dl class="workspace-details">
    <% if @assembly.controlled_fdr? %>
      <div><dt>Functional configuration</dt><dd><%= link_to @assembly.functional_configuration, hangar_fdr_functional_configuration_path(@assembly.fdr_functional_configuration) %></dd></div>
      <div><dt><%= @assembly.fdr_component_type.present? ? "Device type" : "Assembly method" %></dt><dd><%= @assembly.fdr_component_label || @assembly.assembly_method_label %></dd></div>
      <% if @assembly.controlled_fdr? && !@assembly.fdr_system? %><div><dt>ECU ID</dt><dd class="workspace-mono"><%= ecu_label(@assembly.embedded_controller&.device_id) || "Not identified" %></dd></div><% end %>
    <% end %>
    <div><dt>Serviceability</dt><dd><%= @assembly.serviceability_label %></dd></div>
    <% if @assembly.controlled_fdr? && !@assembly.fdr_system? %><div><dt>IMU mounting</dt><dd><%= Imu::Mount::LABELS.fetch(@assembly.imu_mount_profile) %><br><%= Imu::Mount.description(@assembly.imu_mount_profile) %></dd></div><% end %>
    <div><dt>Internal Asset ID</dt><dd class="workspace-mono"><%= @assembly.internal_number %></dd></div>
  </dl>
  <% if @assembly.controlled_fdr? %><p class="workspace-muted workspace-preserve-lines"><%= @assembly.fdr_functional_configuration.planned_capabilities %></p><% end %>
  <% if @assembly.notes.present? %><p class="workspace-notes"><%= simple_format @assembly.notes %></p><% end %>
</section>

<%= render "components" %>
<%= render "fdr_system" if @assembly.fdr_component_type.present? %>

<section class="workspace-panel danger-panel" aria-labelledby="assembly-sensitive-zone">
  <h2 id="assembly-sensitive-zone">Sensitive zone</h2>
  <p>Retiring this assembly is recommended instead of deleting it: retirement preserves its identity and installation history for traceability. Remove it from its aircraft and parent assembly first, then set its serviceability to Retired.</p>
  <p>Deletion is permanent and cannot be undone. Assemblies with parts, subassemblies, a parent assembly, installation history, board installation history, system membership history or flight history cannot be deleted.</p>
  <%= button_to "Delete assembly", hangar_assembly_path(@assembly), method: :delete, class: "button-danger",
    form: { data: { turbo_confirm: "Delete #{@assembly.display_name} (#{@assembly.internal_number}) permanently? This cannot be undone. Retire the assembly instead to preserve traceability." } } %>
</section>
