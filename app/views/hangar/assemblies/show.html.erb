<% content_for :title, @assembly.controlled_fdr? ? @assembly.serial_label : @assembly.name %>
<%= render "hangar/tabs" %>

<header class="workspace-header">
  <% if @assembly.controlled_fdr? %>
    <div><span class="section-eyebrow">Assembly</span><h2><%= @assembly.display_name %></h2></div>
  <% else %>
    <div><span class="section-eyebrow">Assembly</span><h2><%= @assembly.name %></h2><p>Asset ID <%= @assembly.internal_number %></p></div>
  <% end %>
  <div class="workspace-actions">
    <% if @assembly.embedded_controller %><%= link_to "Open in Forge", forge_fdr_path(@assembly.embedded_controller), class: "button-primary" %><% end %>
    <%= link_to "Edit", edit_hangar_assembly_path(@assembly), class: "button-secondary" %>
    <% unless @assembly.controlled_fdr? %>
      <%= button_to "Delete", hangar_assembly_path(@assembly), method: :delete, class: "button-danger", form: { data: { turbo_confirm: "Delete #{@assembly.internal_number} permanently? This cannot be undone." } } %>
    <% end %>
  </div>
</header>

<section class="workspace-panel">
  <div class="workspace-panel-header"><h2>Identity</h2><span>Physical assembly</span></div>
  <dl class="workspace-details">
    <% if @assembly.controlled_fdr? %>
      <div><dt>Functional configuration</dt><dd><%= link_to @assembly.functional_configuration, hangar_fdr_functional_configuration_path(@assembly.fdr_functional_configuration) %></dd></div>
      <div><dt>Assembly method</dt><dd><%= @assembly.assembly_method_label %></dd></div>
      <div><dt>ECU ID</dt><dd class="workspace-mono"><%= @assembly.embedded_controller&.device_id || "Not identified" %></dd></div>
    <% end %>
    <div><dt>Serviceability</dt><dd><%= @assembly.serviceability_label %></dd></div>
    <div><dt>Internal Asset ID</dt><dd class="workspace-mono"><%= @assembly.internal_number %></dd></div>
  </dl>
  <% if @assembly.controlled_fdr? %><p class="workspace-muted workspace-preserve-lines"><%= @assembly.fdr_functional_configuration.planned_capabilities %></p><% end %>
  <% if @assembly.notes.present? %><p class="workspace-notes"><%= simple_format @assembly.notes %></p><% end %>
</section>

<div class="workspace-grid is-assembly">
  <section class="workspace-panel is-wide">
    <div class="workspace-panel-header"><h2>Composition</h2><span><%= pluralize @assembly.snapshot_part_numbers.size, "serialized part" %></span></div>
    <%= render "tree", assembly: @assembly %>
  </section>

  <div class="workspace-stack">
    <section class="workspace-panel">
      <h2>Install part</h2>
      <% if @available_parts.any? %>
        <%= form_with url: install_part_hangar_assembly_path(@assembly), class: "workspace-inline-form" do |form| %>
          <%= form.collection_select :part_id, @available_parts, :id, ->(part) { "#{part.display_name} · #{part.serial_number.presence || part.internal_number} · #{part.function.name}" } %>
          <%= form.submit "Install", class: "button-primary" %>
        <% end %>
      <% else %><p class="workspace-muted">No available part.</p><% end %>
    </section>

    <section class="workspace-panel">
      <h2>Attach subassembly</h2>
      <% if @available_assemblies.any? %>
        <%= form_with url: attach_assembly_hangar_assembly_path(@assembly), class: "workspace-inline-form" do |form| %>
          <%= form.collection_select :child_id, @available_assemblies, :id, :selection_label %>
          <%= form.submit "Attach", class: "button-primary" %>
        <% end %>
      <% else %><p class="workspace-muted">No root assembly available.</p><% end %>
    </section>
  </div>
</div>

<section class="workspace-panel">
  <h2>Direct parts</h2>
  <% if @assembly.parts.any? %>
    <div class="workspace-list">
      <% @assembly.parts.includes(:function).ordered.each do |part| %>
        <div class="workspace-list-row is-static">
          <span><strong><%= part.display_name %> · <%= part.function.name %></strong><small><%= part.serial_number.present? ? "S/N #{part.serial_number} · Asset ID #{part.internal_number}" : "Asset ID #{part.internal_number}" %><%= " · ECU ID #{part.embedded_controller.device_id}" if part.embedded_controller&.device_id %></small></span>
          <div class="workspace-actions">
            <% replacements = @available_parts.select { |candidate| candidate.function_id == part.function_id } %>
            <% if replacements.any? %>
              <%= form_with url: replace_part_hangar_assembly_path(@assembly, part_id: part.id), method: :patch, class: "workspace-compact-form" do |form| %>
                <%= form.collection_select :replacement_part_id, replacements, :id, :internal_number %>
                <%= form.submit "Replace", class: "button-secondary" %>
              <% end %>
            <% end %>
            <%= button_to "Remove", remove_part_hangar_assembly_path(@assembly, part_id: part.id), method: :delete, class: "button-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %><div class="workspace-empty">No part installed directly in this assembly.</div><% end %>
</section>

<% if @assembly.children.any? %>
  <section class="workspace-panel">
    <h2>Direct subassemblies</h2>
    <div class="workspace-list">
      <% @assembly.children.ordered.each do |child| %>
        <div class="workspace-list-row is-static"><span><strong><%= child.selection_label %></strong></span><%= button_to "Detach", detach_assembly_hangar_assembly_path(@assembly, child_id: child.id), method: :delete, class: "button-secondary" %></div>
      <% end %>
    </div>
  </section>
<% end %>
