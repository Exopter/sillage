<%= form_with model: [ :hangar, assembly ], class: "workspace-form" do |form| %>
  <% if assembly.errors.any? %><div class="workspace-errors"><%= assembly.errors.full_messages.to_sentence %></div><% end %>
  <div class="workspace-form-grid">
    <label><span>Name</span><%= form.text_field :name, required: true, placeholder: "Equipment assembly" %></label>
    <label><span>Serial number</span><%= text_field_tag nil, assembly.serial_number || "Generated automatically for an ExoFDR", disabled: true %></label>
    <label class="is-wide"><span>Hardware definition</span><%= form.collection_select :hardware_definition_id, @hardware_definitions, :id, ->(definition) { "#{definition.product_name} · #{definition.canonical_identifier}" }, { include_blank: "No controlled definition" } %></label>
    <label><span>Serviceability</span><%= form.select :serviceability_state, Assembly::SERVICEABILITY_STATES.map { |state| [state.humanize, state] } %></label>
    <label class="is-wide"><span>Parent assembly</span><%= form.collection_select :parent_id, @parent_options, :id, :selection_label, { include_blank: "No parent" } %></label>
    <label><span>Internal Asset ID</span><%= text_field_tag nil, assembly.internal_number || "Assigned automatically", disabled: true %></label>
  </div>
  <label><span>Notes</span><%= form.text_area :notes, rows: 4 %></label>
  <div class="workspace-actions">
    <%= link_to "Cancel", assembly.persisted? ? hangar_assembly_path(assembly) : hangar_assemblies_path, class: "button-secondary" %>
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
