<% content_for :title, @function.name %><%= render "hangar/tabs" %><header class="workspace-header"><div><span class="section-eyebrow">Function</span><h2><%= @function.name %></h2><p><%= @function.description %></p></div><%= link_to "Edit", edit_hangar_function_path(@function), class: "button-secondary" %></header><section class="workspace-panel"><div class="workspace-list"><% @parts.each do |part| %><%= link_to hangar_part_path(part), class: "workspace-list-row" do %><span><strong><%= part.internal_number %></strong><small><%= part.display_name %></small></span><span><%= part.state.titleize %></span><% end %><% end %></div></section>
