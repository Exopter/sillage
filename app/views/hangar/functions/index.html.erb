<% content_for :title, "Fleet configuration" %><%= render "hangar/tabs" %>
<header class="hangar-section-head"><div><h2>Functions</h2><p>Controlled roles classify Parts without adding a level to the physical hierarchy.</p></div><div class="workspace-actions"><span class="hangar-admin-badge">Admin</span><%= link_to new_hangar_function_path, class: "button-primary" do %><%= sillage_icon "plus", size: 17 %><span>New function</span><% end %></div></header>
<section class="hangar-function-grid"><% @functions.each do |function| %><%= link_to hangar_function_path(function), class: "hangar-function-card" do %><h3><%= function.name %></h3><p><%= function.description %></p><footer><span class="section-eyebrow">Assigned inventory</span><strong><%= pluralize function.parts.count, "part" %></strong></footer><% end %><% end %></section>
