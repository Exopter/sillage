<% content_for :title, "Parts · Hangar" %>

<%= render "hangar/tabs" %>
<%= render "hangar/inventory_head", view: "list" %>

<%= form_with url: hangar_parts_path, method: :get, class: "workspace-filterbar", data: { controller: "auto-submit" } do |form| %>
  <label class="search-control">
    <span class="sr-only">Search parts</span>
    <%= sillage_icon "search", size: 16 %>
    <%= form.search_field :q, value: @query, placeholder: "Search part, serial, function…", autocomplete: "off" %>
  </label>
  <label class="workspace-state-filter">
    <span class="sr-only">Filter by state</span>
    <%= form.select :state, options_for_select([["Current parts", ""], ["All states", "all"], *Part::STATES.map { |state| [state.titleize, state] }], @state), {}, data: { action: "change->auto-submit#submit" } %>
  </label>
  <% if @query.present? || @state.present? %><%= link_to "Clear", hangar_parts_path, class: "button-secondary exds-btn exds-btn--secondary" %><% end %>
  <span class="workspace-result-count"><%= pluralize @parts.size, "part" %></span>
<% end %>

<section class="workspace-panel is-flush">
  <% if @parts.any? %>
    <div class="workspace-table-wrap">
      <table class="workspace-table is-stacked">
        <thead><tr><th>Part</th><th>Function</th><th>Serial</th><th>Where</th><th>State</th><th class="workspace-table-actions">Actions</th></tr></thead>
        <tbody>
          <% @parts.each do |part| %>
            <tr>
              <td><%= link_to part.display_name, hangar_part_path(part), class: "workspace-strong-link" %><br><small class="workspace-muted">Asset ID <%= part.internal_number %></small></td>
              <td data-label="Function"><%= part.function.name %></td>
              <td data-label="Serial"><%= part.serial_number.presence || "—" %></td>
              <td data-label="Where"><% if part.assembly %><%= link_to part.assembly.identity_label, hangar_assembly_path(part.assembly) %><% elsif (aircraft = @part_aircraft[part.id]) %><%= link_to aircraft.registration, hangar_aircraft_path(aircraft) %><% else %>In stock<% end %></td>
              <td><span class="status-dot is-<%= part.state == "quarantined" ? "caution" : part.state == "retired" ? "fault" : part.state == "available" ? "unknown" : "ready" %>"><span></span><%= part.state == "quarantined" ? "Review flag" : part.state.titleize %></span></td>
              <td class="workspace-table-actions">
                <div class="workspace-actions">
                  <%= link_to "Edit", edit_hangar_part_path(part), class: "button-secondary exds-btn exds-btn--secondary is-compact" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="workspace-empty">No parts registered yet. <%= link_to "Register the first part", new_hangar_part_path %> to build the inventory.</div>
  <% end %>
</section>
