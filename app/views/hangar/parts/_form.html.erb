<%= form_with model: [ :hangar, part ], class: "workspace-form" do |form| %>
  <% if part.errors.any? %>
    <div class="workspace-errors"><%= part.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="workspace-form-grid">
    <fieldset class="hangar-chips">
      <legend>Function</legend>
      <%= form.collection_radio_buttons :function_id, @functions, :id, :name do |choice| %><%= choice.label { choice.radio_button(required: true) + content_tag(:span, choice.text) } %><% end %>
    </fieldset>
    <label>
      <span>Manufacturer</span>
      <%= form.text_field :manufacturer %>
    </label>
    <label>
      <span>Model</span>
      <%= form.text_field :model, required: true %>
    </label>
    <label>
      <span>Serial number</span>
      <%= form.text_field :serial_number %>
    </label>
    <% if can_manage_operations? %>
      <label>
        <span>State</span>
        <% if part.state == "installed" %>
          <%= text_field_tag nil, "Installed", disabled: true %>
        <% else %>
          <%= form.select :state, Part::EDITABLE_STATES.map { |state| [ state.titleize, state ] } %>
        <% end %>
      </label>
    <% end %>
  </div>

  <% unless part.persisted? %>
    <label>
      <span>Install it now (optional)</span>
      <%= form.collection_select :assembly_id, @assemblies, :id, :selection_label, { include_blank: "Leave in stock", selected: @selected_assembly_id } %>
    </label>
  <% end %>
  <% if part.persisted? %>
    <label>
      <span>Assembly</span>
      <%= form.collection_select :assembly_id, @assemblies, :id, :selection_label,
        { include_blank: "Not installed in an assembly", selected: @selected_assembly_id } %>
      <small>Changing the assembly records a new installation and preserves the previous installation history.</small>
    </label>
  <% end %>

  <label>
    <span>Notes</span>
    <%= form.text_area :notes, rows: 4 %>
  </label>

  <p class="workspace-muted"><%= part.persisted? ? "Asset ID #{part.internal_number}" : "The asset ID is assigned when you save." %></p>
  <div class="workspace-actions">
    <%= link_to "Cancel", part.persisted? ? hangar_part_path(part) : hangar_parts_path, class: "button-secondary exds-btn exds-btn--secondary" %>
    <%= form.submit class: "button-primary exds-btn exds-btn--primary" %>
  </div>
<% end %>
