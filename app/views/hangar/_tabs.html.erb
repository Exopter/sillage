<header class="hangar-head">
  <h1 class="sr-only">Hangar</h1>
  <div class="exds-tabs hangar-tabs">
    <nav class="exds-tab-group" aria-label="Hangar inventory">
      <%= link_to "Fleet", hangar_aircraft_index_path, class: "exds-tab", aria: { current: ("page" if controller_name.in?(%w[aircraft installations])) } %>
      <%= link_to "Inventory", hangar_assemblies_path, class: "exds-tab", aria: { current: ("page" if controller_name.in?(%w[assemblies parts])) } %>
    </nav>
    <span class="exds-tab-divider" aria-hidden="true"></span>
    <nav class="exds-tab-group" aria-label="Hangar configuration">
      <%= link_to "Reference", hangar_functions_path, class: "exds-tab", aria: { current: ("page" if controller_name.in?(%w[functions fdr_functional_configurations])) } %>
    </nav>
  </div>
  <%= form_with url: hangar_assemblies_path, method: :get, class: "hangar-search", role: "search" do %>
    <label class="search-control"><span class="sr-only">Search the hangar</span><%= sillage_icon "search", size: 16 %><%= search_field_tag :q, params[:q], placeholder: "Find a serial, a name or an asset ID", autocomplete: "off", id: nil %></label>
  <% end %>
</header>
