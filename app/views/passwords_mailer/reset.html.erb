<% reset_url = edit_password_url(@user.password_reset_token) %>
<h1 style="margin:0 0 16px;font-family:'Aptos','Segoe UI',-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:24px;line-height:28px;font-weight:600;color:#070b0d;">Reset your password</h1>
<p style="margin:0 0 16px;">Someone asked to reset the password of your Sillage account. If it was you, choose a new one.</p>
<p style="margin:0 0 20px;"><%= link_to "Reset password", reset_url, style: "display:inline-block;padding:10px 16px;border-radius:8px;background-color:#10181a;color:#ffffff;font-family:'Aptos','Segoe UI',-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:18px;font-weight:600;text-decoration:none;" %></p>
<p style="margin:0 0 16px;font-size:12px;line-height:16px;color:#5f6c6b;">The link works for 30 minutes. If you did not ask for it, ignore this email: your password stays unchanged.</p>
<p style="margin:0;padding-top:16px;border-top:1px solid #d4dfdc;font-size:12px;line-height:16px;color:#5f6c6b;word-break:break-all;">If the button does not open, copy this address into your browser:<br><%= reset_url %></p>
