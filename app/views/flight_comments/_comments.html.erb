<% new_comment = local_assigns[:new_comment] || FlightComment.new %>
<% editing_comment = local_assigns[:editing_comment] %>
<% comments = flight.comments.includes(user: { avatar_attachment: :blob }, images_attachments: :blob).chronological.to_a %>
<%= turbo_frame_tag dom_id(flight, :comments), class: "exds-comments exds-browser-editor-section", role: "region", aria: { label: "Flight comments" }, data: { controller: "flight-comments", action: "keydown.esc->flight-comments#close click@window->flight-comments#outside" } do %>
  <%# The recorder leaves once the flight has its debrief; deleting the entry or recording again brings it back. %>
  <% recorded = flight.flight_debriefs.where.not(flight_comment_id: nil).to_a %>
  <% replacing = recorded.find { |debrief| debrief.id.to_s == params[:rerecord].to_s && debrief.user_id == Current.user.id } %>
  <%= render "flight_debriefs/recorder", flight: flight, replacing: replacing if can_manage_operations? && (recorded.empty? || replacing) %>
  <div class="exds-comments-heading"><h3>Comments</h3><span><%= comments.size %></span></div>
  <% if comments.empty? %><p class="exds-comments-empty">No comments yet.<%= " Add the first observation." if can_manage_operations? %></p><% end %>
  <% comments.each do |comment| %>
    <% current = editing_comment&.id == comment.id ? editing_comment : comment %>
    <article class="exds-comment" id="<%= dom_id(comment) %>">
      <%= render "shared/user_avatar", user: comment.user, avatar_class: "exds-comment-avatar" %>
      <div class="exds-comment-main">
        <div class="exds-comment-header">
          <div><strong><%= comment_author_name(comment.user) %></strong><% if comment.owned_by?(Current.user) %><span class="exds-comment-you">You</span><% end %>
            <div class="exds-comment-date"><%= local_time comment.created_at %><% if comment.edited_at %><span> · Edited</span><% end %><% if comment.imported_from_notes? %><span title="Migrated from a note. The date is the last flight update, not the original note date."> · Migrated note (approximate date)</span><% end %></div>
          </div>
          <% if can_manage_operations? && comment.owned_by?(Current.user) && !editing_comment %>
            <details class="exds-comment-actions">
              <summary class="exds-browser-icon-button is-quiet" aria-label="Actions for comment by <%= comment_author_name(comment.user) %>"><%= sillage_icon "ellipsis", size: 16 %></summary>
              <div class="exds-comment-menu">
                <%= link_to edit_flight_comment_path(flight, comment) do %><%= sillage_icon "pencil", size: 16 %> <%= comment.flight_debrief ? "Edit debrief" : "Edit comment" %><% end %>
                <% if comment.flight_debrief %><%= link_to flight_comments_path(flight, rerecord: comment.flight_debrief.id) do %><%= sillage_icon "mic", size: 16 %> Record again<% end %><% end %>
                <button type="button" data-action="flight-comments#confirmDelete"><%= sillage_icon "trash", size: 16 %> Delete comment</button>
              </div>
            </details>
          <% end %>
        </div>
        <% if can_manage_operations? && editing_comment&.id == comment.id %>
          <%= form_with model: current, url: flight_comment_path(flight, current), class: "exds-comment-edit", data: { action: "input->flight-comments#validate keydown->flight-comments#submitShortcut" } do |form| %>
            <% if current.errors.any? %><p class="workspace-errors" role="alert"><%= current.errors.full_messages.to_sentence %></p><% end %>
            <%# A debrief is edited as it reads: its checklist first, each cell a field, then its summary. %>
            <% if (edited_debrief = comment.flight_debrief) %>
              <div class="flight-debrief-checklist is-editable" role="group" aria-label="Debrief checklist">
                <% DebriefChecklist::ITEMS.each do |item| %>
                  <% field = "#{dom_id(current)}_checklist_#{item[:key]}" %>
                  <div><label for="<%= field %>"><span><%= item[:label] %></span><%= text_field_tag "checklist[#{item[:key]}]", edited_debrief.checklist[item[:key]], id: field, maxlength: 60, autocomplete: "off", autocapitalize: "off", spellcheck: false, enterkeyhint: "done", placeholder: "\u2014" %></label></div>
                <% end %>
              </div>
            <% end %>
            <label class="exds-browser-field exds-comment-editor-field"><span><%= edited_debrief ? "Summary" : "Edit comment" %></span><%= form.text_area :body, id: "#{dom_id(current)}_body", rows: edited_debrief ? 8 : 3, maxlength: FlightComment::MAX_LENGTH, required: true, autofocus: true %></label>
            <%= render "flight_comments/image_fields", form: form, comment: current, field_id: dom_id(current) %>
            <div class="exds-comment-edit-actions"><%= link_to "Cancel", flight_comments_path(flight), class: "button-secondary exds-btn exds-btn--secondary" %><%= form.submit "Save changes", class: "button-primary exds-btn exds-btn--primary" %></div>
          <% end %>
        <% else %>
          <% if (debrief = comment.flight_debrief) %>
            <div class="flight-debrief-entry">
              <span class="flight-debrief-badge"><%= sillage_icon "mic", size: 13 %>Audio debrief</span>
              <dl class="flight-debrief-checklist" aria-label="Debrief checklist">
                <% DebriefChecklist::ITEMS.each do |item| %>
                  <div><dt><%= item[:label] %></dt><dd><%= debrief_checklist_value(debrief.checklist[item[:key]]) %></dd></div>
                <% end %>
              </dl>
              <% if debrief.summary_pending? %>
                <p class="flight-debrief-pending"<% if comment.owned_by?(Current.user) %> data-controller="debrief-summary" data-debrief-summary-url-value="<%= flight_debrief_path(flight, debrief) %>" data-debrief-summary-comments-url-value="<%= flight_comments_path(flight) %>"<% end %>><span class="flight-debrief-spinner" aria-hidden="true"></span>Writing the summary. The audio is already saved.</p>
              <% elsif debrief.status == "failed" && comment.body == FlightDebrief::PENDING_SUMMARY %>
                <p class="flight-debrief-pending"<% if comment.owned_by?(Current.user) %> data-controller="debrief-summary" data-debrief-summary-url-value="<%= flight_debrief_path(flight, debrief) %>" data-debrief-summary-comments-url-value="<%= flight_comments_path(flight) %>"<% end %>>The summary could not be written. The audio is saved.<% if comment.owned_by?(Current.user) %> <button type="button" class="exds-btn exds-btn--secondary exds-btn--sm" data-action="debrief-summary#retry">Retry</button><% end %></p>
              <% else %>
                <%= debrief_summary(comment.body) %>
              <% end %>
              <% if debrief.audio.attached? %>
                <audio class="flight-debrief-audio" controls preload="metadata" data-controller="audio-duration" src="<%= attachment_path(debrief.audio.attachment) %>"></audio>
                <%= link_to attachment_path(debrief.audio.attachment), download: true, class: "flight-debrief-download" do %><%= sillage_icon "download", size: 15 %><span>Download original audio</span><% end %>
              <% elsif !debrief.summary_pending? %>
                <p class="flight-debrief-note"><%= sillage_icon "info", size: 14 %><span>The audio did not reach the server. This entry is written from what was heard live; it is replaced if the phone delivers the recording.</span></p>
              <% end %>
              <% if debrief.transcript.present? %>
                <details class="exds-disclosure flight-debrief-transcript"><summary><%= debrief.audio.attached? ? "Full transcript" : "Live transcript" %></summary><p><%= debrief.transcript %></p></details>
              <% end %>
            </div>
          <% else %>
            <p class="exds-comment-body"><%= comment.body %></p>
          <% end %>
          <% if comment.images.any? %>
            <div class="exds-comment-images">
              <% comment.images.each do |image| %>
                <figure class="exds-comment-image">
                  <%= link_to attachment_path(image), target: "_blank", rel: "noopener", data: { turbo: false }, aria: { label: "Open #{image.filename} in a new tab" } do %>
                    <%= image_tag attachment_path(image), alt: image.filename.to_s, loading: "lazy", decoding: "async" %>
                  <% end %>
                </figure>
              <% end %>
            </div>
          <% end %>
        <% end %>
        <% if can_manage_operations? && comment.owned_by?(Current.user) %>
          <div class="exds-comment-confirm" hidden role="group" aria-label="Confirm comment deletion">
            <strong>Delete this comment?</strong><p>It will be removed for everyone with access to this flight.</p>
            <div class="exds-comment-edit-actions"><button type="button" class="button-secondary exds-btn exds-btn--secondary" data-action="flight-comments#cancelDelete">Cancel</button><%= button_to "Delete comment", flight_comment_path(flight, comment), method: :delete, class: "button-danger exds-btn exds-btn--danger-solid" %></div>
          </div>
        <% end %>
      </div>
    </article>
  <% end %>
  <% if can_manage_operations? %>
  <%= form_with model: new_comment, url: flight_comments_path(flight), class: "exds-comments-compose", data: { action: "input->flight-comments#validate keydown->flight-comments#submitShortcut" } do |form| %>
    <% if new_comment.errors.any? %><p class="workspace-errors" role="alert"><%= new_comment.errors.full_messages.to_sentence %></p><% end %>
    <label class="exds-browser-field exds-comment-editor-field"><span>Add a comment</span><%= form.text_area :body, id: "#{dom_id(flight)}_new_comment_body", rows: 3, maxlength: FlightComment::MAX_LENGTH, required: true, placeholder: "Observations, conditions and anything to remember…" %></label>
    <%= render "flight_comments/image_fields", form: form, comment: new_comment, field_id: "#{dom_id(flight)}_new_comment" %>
    <div class="exds-comments-compose-actions"><small>Visible to people with flight access</small><%= form.submit "Post comment", class: "button-primary exds-btn exds-btn--primary", disabled: new_comment.body.blank? %></div>
  <% end %>
  <% end %>
  <p class="exds-comments-status" role="status"><%= local_assigns[:message] %></p>
<% end %>
