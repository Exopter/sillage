<% new_comment = local_assigns[:new_comment] || FlightComment.new %>
<% editing_comment = local_assigns[:editing_comment] %>
<% comments = flight.comments.includes(:user).chronological.to_a %>
<%= turbo_frame_tag dom_id(flight, :comments), class: "exds-comments exds-browser-editor-section", role: "region", aria: { label: "Flight comments" }, data: { controller: "flight-comments", action: "keydown.esc->flight-comments#close click@window->flight-comments#outside" } do %>
  <div class="exds-comments-heading"><h3>Comments</h3><span><%= comments.size %></span></div>
  <% if comments.empty? %><p class="exds-comments-empty">No comments yet. Add the first observation.</p><% end %>
  <% comments.each do |comment| %>
    <% current = editing_comment&.id == comment.id ? editing_comment : comment %>
    <article class="exds-comment" id="<%= dom_id(comment) %>">
      <span class="exds-comment-avatar" aria-hidden="true"><%= sillage_user_initials(comment.user) %></span>
      <div class="exds-comment-main">
        <div class="exds-comment-header">
          <div><strong><%= comment_author_name(comment.user) %></strong><% if comment.owned_by?(Current.user) %><span class="exds-comment-you">You</span><% end %>
            <div class="exds-comment-date"><time datetime="<%= comment.created_at.iso8601 %>" data-flight-comments-target="timestamp"><%= comment.created_at.utc.strftime("%d %b %Y, %H:%M UTC") %></time><% if comment.edited_at %><span> · Edited</span><% end %><% if comment.imported_from_notes? %><span title="Migrated from a note. The date is the last flight update, not the original note date."> · Migrated note (approximate date)</span><% end %></div>
          </div>
          <% if comment.owned_by?(Current.user) && !editing_comment %>
            <details class="exds-comment-actions">
              <summary class="exds-browser-icon-button is-quiet" aria-label="Actions for comment by <%= comment_author_name(comment.user) %>"><%= sillage_icon "ellipsis", size: 16 %></summary>
              <div class="exds-comment-menu">
                <%= link_to edit_flight_comment_path(flight, comment) do %><%= sillage_icon "pencil", size: 16 %> Edit comment<% end %>
                <button type="button" data-action="flight-comments#confirmDelete"><%= sillage_icon "trash", size: 16 %> Delete comment</button>
              </div>
            </details>
          <% end %>
        </div>
        <% if editing_comment&.id == comment.id %>
          <%= form_with model: current, url: flight_comment_path(flight, current), class: "exds-comment-edit", data: { action: "input->flight-comments#validate keydown->flight-comments#submitShortcut" } do |form| %>
            <% if current.errors.any? %><p class="workspace-errors" role="alert"><%= current.errors.full_messages.to_sentence %></p><% end %>
            <label class="exds-browser-field"><span>Edit comment</span><%= form.text_area :body, id: "#{dom_id(current)}_body", rows: 3, maxlength: FlightComment::MAX_LENGTH, required: true, autofocus: true %></label>
            <div class="exds-comment-edit-actions"><%= link_to "Cancel", flight_comments_path(flight), class: "button-secondary" %><%= form.submit "Save changes", class: "button-primary" %></div>
          <% end %>
        <% else %>
          <p class="exds-comment-body"><%= comment.body %></p>
        <% end %>
        <% if comment.owned_by?(Current.user) %>
          <div class="exds-comment-confirm" hidden role="group" aria-label="Confirm comment deletion">
            <strong>Delete this comment?</strong><p>It will be removed for everyone with access to this flight.</p>
            <div class="exds-comment-edit-actions"><button type="button" class="button-secondary" data-action="flight-comments#cancelDelete">Cancel</button><%= button_to "Delete comment", flight_comment_path(flight, comment), method: :delete, class: "button-danger" %></div>
          </div>
        <% end %>
      </div>
    </article>
  <% end %>
  <%= form_with model: new_comment, url: flight_comments_path(flight), class: "exds-comments-compose", data: { action: "input->flight-comments#validate keydown->flight-comments#submitShortcut" } do |form| %>
    <% if new_comment.errors.any? %><p class="workspace-errors" role="alert"><%= new_comment.errors.full_messages.to_sentence %></p><% end %>
    <label class="exds-browser-field"><span>Add a comment</span><%= form.text_area :body, id: "#{dom_id(flight)}_new_comment_body", rows: 3, maxlength: FlightComment::MAX_LENGTH, required: true, placeholder: "Observations, conditions and anything to remember…" %></label>
    <div class="exds-comments-compose-actions"><small>Visible to people with flight access</small><%= form.submit "Post comment", class: "button-primary", disabled: new_comment.body.blank? %></div>
  <% end %>
  <p class="exds-comments-status" role="status"><%= local_assigns[:message] %></p>
<% end %>
