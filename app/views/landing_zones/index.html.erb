<% content_for :title, "Landing zones" %>

<div class="atlas-root"
     data-controller="atlas-map"
     data-atlas-map-style-url-value="<%= @map_style_url %>"
     data-atlas-map-preload-value="<%= @tile_prefetch_enabled %>"
     data-atlas-map-image-url-value="<%= asset_path("landing-zone-terrain-v1.png") %>">
  <header class="operations-page-head">
    <div>
      <span class="operations-eyebrow">Sillage Atlas</span>
      <h1>Landing zones</h1>
      <p>Landing sites with a map, practical information, and field notes.</p>
    </div>
    <%= link_to new_landing_zone_path, class: "button-secondary" do %>
      <%= sillage_icon "plus", size: 17 %>
      Add landing zone
    <% end %>
  </header>

  <% if @landing_zones.any? %>
    <div class="atlas-layout">
      <aside class="operations-panel atlas-zone-list" aria-label="Available landing zones">
        <div class="atlas-list-head"><span class="operations-eyebrow">Available sites</span></div>
        <% @landing_zones.each_with_index do |zone, index| %>
          <button type="button"
                  class="atlas-zone-button"
                  aria-pressed="<%= index.zero? %>"
                  data-atlas-map-target="zone"
                  data-action="atlas-map#choose"
                  data-selected="<%= index.zero? %>"
                  data-name="<%= zone.name %>"
                  data-elevation="<%= zone.elevation_m.present? ? "#{zone.elevation_m.round} m AMSL" : "Not recorded" %>"
                  data-latitude="<%= zone.latitude %>"
                  data-longitude="<%= zone.longitude %>"
                  data-practical="<%= zone.practical_information %>"
                  data-notes="<%= zone.notes %>">
            <span class="atlas-zone-title"><strong><%= zone.name %></strong><%= sillage_icon "chevron-right", size: 16 %></span>
            <span class="atlas-zone-meta">
              <span><%= zone.elevation_m.present? ? "#{zone.elevation_m.round} m AMSL" : "Altitude unknown" %></span>
              <span><%= zone.code %></span>
            </span>
            <span class="atlas-zone-summary"><%= truncate(zone.notes.presence || zone.practical_information.presence || "No field notes recorded.", length: 118) %></span>
          </button>
        <% end %>
      </aside>

      <section class="operations-panel atlas-detail-panel">
        <div class="atlas-map" data-atlas-map-target="canvas" aria-label="Selected landing zone map">
          <span class="atlas-static-target" data-atlas-map-target="staticMarker" hidden>
            <span><%= sillage_icon "crosshair", size: 23 %></span>
            <strong>Landing zone</strong>
          </span>
        </div>
        <div class="atlas-details">
          <div class="atlas-notes">
            <span class="operations-eyebrow">Notes</span>
            <h2 data-atlas-map-target="name"></h2>
            <p data-atlas-map-target="notes"></p>
          </div>
          <dl class="atlas-facts">
            <div><dt>Elevation</dt><dd data-atlas-map-target="elevation"></dd></div>
            <div><dt>Coordinates</dt><dd data-atlas-map-target="coordinates"></dd></div>
            <div class="is-wide"><dt>Practical information</dt><dd data-atlas-map-target="practical"></dd></div>
          </dl>
        </div>
      </section>
    </div>
  <% else %>
    <section class="operations-empty">
      <%= sillage_icon "map", size: 28 %>
      <h2>No landing zones yet</h2>
      <p>Add the first site used to prepare and identify flights.</p>
      <%= link_to "Add landing zone", new_landing_zone_path, class: "button-primary" %>
    </section>
  <% end %>
</div>
