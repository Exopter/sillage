<article class="build-snapshot-node">
  <header><strong><%= node["serial_number"].presence || node["name"] %></strong><span>Asset ID <%= node["internal_number"] %><%= " · Historical identifier" if node["serial_number"].to_s.start_with?("FDR-") %></span></header>
  <% if node["functional_configuration"] %><p class="workspace-muted workspace-preserve-lines"><%= node.dig("functional_configuration", "planned_capabilities") %></p><% end %>
  <% if Array(node["parts"]).any? %>
    <ul>
      <% Array(node["parts"]).each do |part| %>
        <li><span class="assembly-function"><%= part["function"] %></span><strong><%= [ part["manufacturer"], part["model"] ].compact_blank.join(" ") %></strong><small><%= [ ("S/N #{part["serial_number"]}" if part["serial_number"].present?), "Asset ID #{part["internal_number"]}", ("ECU ID #{part.dig("embedded_controller", "device_id")}" if part.dig("embedded_controller", "device_id").present?) ].compact.join(" · ") %></small></li>
      <% end %>
    </ul>
  <% end %>
  <% Array(node["assemblies"]).each do |child| %><div class="assembly-tree-child"><%= render "snapshot", node: child %></div><% end %>
</article>
