<% content_for :title, "#{@fdr.display_name} · #{@fdr.technical_reference}" %>
<%= render "forge/tabs" %>

<div class="fdr-connectivity">
  <%= render "shell", active_tab: :overview %>

  <div class="workspace-grid">
    <section class="workspace-panel">
      <div class="workspace-panel-header"><h2>Controller identity</h2><span>Learned from the ECU</span></div>
      <dl class="workspace-details">
        <div><dt>ECU ID</dt><dd class="workspace-mono"><%= ecu_label(@fdr.device_id).presence || "Not identified" %></dd></div>
        <div><dt>Hardware platform</dt><dd><%= @fdr.device_model.presence || "Not reported" %></dd></div>
        <div><dt>Firmware</dt><dd><%= @fdr.last_seen_firmware.presence || "Not reported" %></dd></div>
        <div><dt>Last identified</dt><dd><%= @fdr.last_identified_at ? "#{time_ago_in_words(@fdr.last_identified_at)} ago" : "Never" %></dd></div>
        <div><dt>MAVLink</dt><dd><%= @fdr.mavlink_identity_label.presence || "Not observed" %></dd></div>
      </dl>
    </section>

    <section class="workspace-panel">
      <div class="workspace-panel-header"><h2>Security and Signal</h2><span>Observed state</span></div>
      <% presence = @fdr.signal_presence %>
      <dl class="workspace-details">
        <div><dt>Initialization</dt><dd><span class="workspace-status <%= @fdr.initialized? ? "is-validated" : "is-blocked" %>"><%= @fdr.initialized? ? "Initialized" : "Required" %></span></dd></div>
        <div><dt>Last Signal presence</dt><dd><%= presence&.last_seen_at ? "#{time_ago_in_words(presence.last_seen_at)} ago" : "Never" %></dd></div>
        <div><dt>Health</dt><dd><%= presence&.health_label || "Not reported" %></dd></div>
        <div><dt>Last synchronization</dt><dd><%= presence&.synchronization_label || "Not reported" %></dd></div>
      </dl>
      <p class="workspace-muted">Heartbeat and telemetry samples remain in Signal; only the latest observed presence is summarized here.</p>
    </section>
  </div>

  <div class="workspace-grid">
    <section class="workspace-panel">
      <div class="workspace-panel-header"><h2>Controller part</h2><span>Owned by Hangar</span></div>
      <%= form_with model: @fdr, url: forge_fdr_path(@fdr), class: "workspace-form" do |form| %>
        <% if @fdr.errors.any? %><div class="workspace-errors"><%= @fdr.errors.full_messages.to_sentence %></div><% end %>
        <label>
          <span>Controller part</span>
          <%= form.collection_select :part_id, @available_controller_parts, :id, ->(part) { "#{part.display_name} · #{part.serial_number.presence || part.internal_number}" }, { include_blank: "No controller part assigned" } %>
        </label>
        <div class="workspace-actions"><%= form.submit "Update assignment", class: "button-primary" %></div>
      <% end %>
    </section>

  </div>
</div>
