<section id="sillage-fdr-connectivity" data-turbo-permanent
         class="signal-fdr-connectivity <%= "exds-recorder-manager" if local_assigns[:workspace] %>"
         data-controller="fdr-connectivity"
         <% if local_assigns[:expected_device_id].present? %>data-fdr-connectivity-expected-device-id-value="<%= expected_device_id %>"<% end %>
         data-fdr-connectivity-upload-url-value="<%= api_v1_fdr_syncs_path %>"
         data-fdr-connectivity-registration-url-value="<%= api_v1_fdr_registration_path %>"
         data-fdr-connectivity-authentication-url-value="<%= api_v1_fdr_authentication_path %>"
         data-fdr-connectivity-recording-command-url-value="<%= api_v1_fdr_recording_commands_path %>"
         data-fdr-connectivity-sillage-heartbeat-url-value="<%= api_v1_fdr_sillage_heartbeats_path %>">
  <% if local_assigns[:workspace] %>
    <%= render "forge/fdrs/shell", active_tab: :files %>
    <div class="exds-recorder-context">
      <div><%= sillage_icon "wifi", size: 24 %><span><strong data-forge-connection>Not connected</strong><small data-forge-identity><%= @assembly&.display_name || @fdr&.display_name %></small></span></div>
      <div><%= sillage_icon "pause", size: 20 %><span><strong data-forge-import-status>Waiting for recorder</strong><small data-forge-import-detail>Connect to view recordings.</small></span></div>
      <button type="button" class="button-primary" data-forge-pause data-action="fdr-connectivity#pauseImports" hidden>Pause imports</button>
      <button type="button" class="button-secondary" data-action="fdr-connectivity#toggleConnections"><%= sillage_icon "settings", size: 16 %> Connections</button>
    </div>
    <details class="exds-recorder-connections" data-forge-connections>
      <summary>Connection options</summary>
  <% else %>
    <header class="signal-fdr-head"><div><h2>Connect a recorder</h2><p>Connect over USB-C or Bluetooth to identify and initialize a recorder.</p></div></header>
  <% end %>

  <div class="signal-fdr-transports" aria-label="Recorder connections">
    <article class="signal-fdr-transport">
      <div class="signal-fdr-channel-head signal-fdr-channel-head--usb">
        <div class="signal-fdr-channel-identity">
          <span class="signal-fdr-channel-icon"><%= sillage_icon "usb-c", size: 19, stroke_width: 2.4 %></span>
          <div>
            <div class="signal-fdr-channel-name">
              <span class="signal-k">USB-C</span>
              <div class="signal-fdr-capabilities">
                <button type="button" class="signal-fdr-capabilities-trigger"
                        aria-label="USB-C capabilities"
                        aria-describedby="usb-capabilities-tooltip">
                  <%= sillage_icon "info", size: 12 %>
                </button>
                <div id="usb-capabilities-tooltip" class="signal-fdr-capabilities-tooltip" role="tooltip">
                  <span>Capabilities</span>
                  <ul>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Live status, settings and diagnostics</span></li>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Authenticated persistent recording control</span></li>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Telemetry synchronization, persistent recording control and authenticated recording erasure</span></li>
                  </ul>
                </div>
              </div>
            </div>
            <strong data-fdr-connectivity-target="usbStatus" data-state="disconnected">Not connected</strong>
          </div>
        </div>
        <div class="signal-fdr-channel-actions">
          <button type="button" class="signal-tool-button" hidden
                  data-action="fdr-connectivity#interruptUsbSync"
                  data-fdr-connectivity-target="stopSyncButton">Stop transfer</button>
          <button type="button" class="signal-tool-button is-danger" hidden
                  data-action="fdr-connectivity#eraseSdRecordings"
                  data-fdr-connectivity-target="eraseSdButton">Erase recordings</button>
          <button type="button" class="signal-tool-button"
                  data-action="fdr-connectivity#connectUsb"
                  data-fdr-connectivity-target="usbButton">Connect USB-C</button>
        </div>
      </div>
      <div class="signal-fdr-transport-feedback">
        <div class="signal-fdr-device-row">
          <strong data-fdr-connectivity-target="usbDevice">No recorder selected</strong>
        </div>
        <small class="signal-fdr-technical" data-fdr-connectivity-target="usbIdentityDetail" hidden></small>
        <div class="signal-fdr-transport-notice" data-fdr-connectivity-target="usbNotice" data-state="status" role="status" hidden>
          <span class="signal-fdr-transport-notice-label" data-fdr-connectivity-target="usbNoticeLabel">Connection status</span>
          <small class="signal-fdr-transport-message" data-fdr-connectivity-target="usbDetail" hidden></small>
          <small class="signal-fdr-technical" data-fdr-connectivity-target="usbTechnical" hidden></small>
        </div>
      </div>
    </article>

    <article class="signal-fdr-transport">
      <div class="signal-fdr-channel-head">
        <div class="signal-fdr-channel-identity">
          <span class="signal-fdr-channel-icon"><%= sillage_icon "bluetooth", size: 17 %></span>
          <div>
            <div class="signal-fdr-channel-name">
              <span class="signal-k">Bluetooth</span>
              <div class="signal-fdr-capabilities">
                <button type="button" class="signal-fdr-capabilities-trigger"
                        aria-label="Bluetooth capabilities"
                        aria-describedby="ble-capabilities-tooltip">
                  <%= sillage_icon "info", size: 12 %>
                </button>
                <div id="ble-capabilities-tooltip" class="signal-fdr-capabilities-tooltip" role="tooltip">
                  <span>Capabilities</span>
                  <ul>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Live status, settings and diagnostics</span></li>
                  </ul>
                </div>
              </div>
            </div>
            <strong data-fdr-connectivity-target="bleStatus" data-state="disconnected">Not connected</strong>
          </div>
        </div>
        <button type="button" class="signal-tool-button" data-action="fdr-connectivity#connectBle" data-fdr-connectivity-target="bleButton">Connect BLE</button>
      </div>
      <div class="signal-fdr-transport-feedback">
        <div class="signal-fdr-device-row">
          <strong data-fdr-connectivity-target="bleDevice">No recorder selected</strong>
        </div>
        <small class="signal-fdr-technical" data-fdr-connectivity-target="bleIdentityDetail" hidden></small>
        <div class="signal-fdr-transport-notice" data-fdr-connectivity-target="bleNotice" data-state="status" role="status" hidden>
          <span class="signal-fdr-transport-notice-label" data-fdr-connectivity-target="bleNoticeLabel">Connection status</span>
          <small class="signal-fdr-transport-message" data-fdr-connectivity-target="bleDetail" hidden></small>
        </div>
      </div>
    </article>

    <article class="signal-fdr-transport">
      <div class="signal-fdr-channel-head">
        <div class="signal-fdr-channel-identity">
          <span class="signal-fdr-channel-icon"><%= sillage_icon "wifi", size: 17 %></span>
          <div>
            <div class="signal-fdr-channel-name">
              <span class="signal-k">Wi-Fi</span>
              <div class="signal-fdr-capabilities">
                <button type="button" class="signal-fdr-capabilities-trigger"
                        aria-label="Wi-Fi capabilities"
                        aria-describedby="wifi-capabilities-tooltip">
                  <%= sillage_icon "info", size: 12 %>
                </button>
                <div id="wifi-capabilities-tooltip" class="signal-fdr-capabilities-tooltip" role="tooltip">
                  <span>Capabilities</span>
                  <ul>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Signed live status and diagnostics</span></li>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Automatic resumable recording upload</span></li>
                    <li><%= sillage_icon "check", size: 11, stroke_width: 2.5 %><span>Authenticated persistent recording control</span></li>
                  </ul>
                </div>
              </div>
            </div>
            <strong data-fdr-connectivity-target="wifiStatus" data-state="disconnected">Not connected</strong>
          </div>
        </div>
        <div class="signal-fdr-channel-actions signal-fdr-channel-actions--wifi">
          <% wifi_configuration_url = @default_wifi_configuration_fdr ? connectivity_forge_fdr_path(@default_wifi_configuration_fdr) : "#{forge_fdrs_path}#registered-recorders" %>
          <% wifi_configuration_label = @default_wifi_configuration_fdr ? "Configure Wi-Fi for #{@default_wifi_configuration_fdr.display_name}" : "Select a recorder for Wi-Fi configuration" %>
          <%= link_to wifi_configuration_url,
            class: "signal-fdr-wifi-settings-link",
            title: wifi_configuration_label,
            aria: { label: wifi_configuration_label },
            data: { fdr_connectivity_target: "wifiLink" } do %>
            <%= sillage_icon "settings", size: 15 %>
            <span class="sr-only" data-fdr-connectivity-target="wifiLinkLabel"><%= wifi_configuration_label %></span>
          <% end %>
          <button type="button"
                  class="signal-tool-button signal-fdr-auto-label"
                  data-fdr-connectivity-target="wifiAutoLabel"
                  aria-label="Automatic Wi-Fi connection: waiting for signed Sillage heartbeat"
                  title="Waiting for signed Sillage heartbeat"
                  disabled>Automatic</button>
        </div>
      </div>
      <div class="signal-fdr-transport-feedback">
        <div class="signal-fdr-device-row">
          <strong data-fdr-connectivity-target="wifiDevice">No recorder detected</strong>
        </div>
        <small class="signal-fdr-technical" data-fdr-connectivity-target="wifiIdentityDetail" hidden></small>
        <div class="signal-fdr-transport-notice" data-fdr-connectivity-target="wifiNotice" data-state="status" role="status" hidden>
          <span class="signal-fdr-transport-notice-label" data-fdr-connectivity-target="wifiNoticeLabel">Automatic connection</span>
          <small class="signal-fdr-transport-message" data-fdr-connectivity-target="wifiDetail" hidden></small>
        </div>
      </div>
    </article>
  </div>

  <% if local_assigns[:workspace] %></details><% end %>
  <div class="exds-recorder-progress">
          <progress class="signal-fdr-progress" value="0" max="1" aria-label="Synchronization progress" data-fdr-connectivity-target="syncProgress" hidden></progress>
          <div class="signal-fdr-transport-notice" data-fdr-connectivity-target="syncNotice" data-state="status" role="status" hidden>
            <span class="signal-fdr-transport-notice-label" data-fdr-connectivity-target="syncNoticeLabel">Synchronization</span>
            <small class="signal-fdr-transport-message" data-fdr-connectivity-target="syncDetail" hidden></small>
            <small class="signal-fdr-technical" data-fdr-connectivity-target="syncTechnical" hidden></small>
          </div>
  </div>
  <%= render "forge/fdrs/recordings" %>

  <section class="signal-fdr-overview" aria-labelledby="recorder-information-title">
    <header class="signal-fdr-section-head signal-fdr-overview-head" <%= "hidden" if local_assigns[:workspace] %>>
      <div class="signal-fdr-overview-title">
        <div><h3 id="recorder-information-title">Recorder information</h3></div>
        <span class="signal-fdr-recorder-status" hidden
              data-fdr-connectivity-target="recorderStatus"
              data-state="disconnected"></span>
      </div>
      <div class="signal-fdr-overview-actions">
        <span class="signal-fdr-source" data-fdr-connectivity-target="recorderSource" data-state="disconnected" hidden></span>
        <% unless local_assigns[:workspace] %><%= render "forge/fdrs/recording_control" %><% end %>
      </div>
    </header>
    <div class="signal-fdr-recorder-alert" data-fdr-connectivity-target="recorderAlert" role="alert" hidden>
      <strong data-fdr-connectivity-target="recorderAlertMessage"></strong>
      <small data-fdr-connectivity-target="recorderAlertTechnical" hidden></small>
    </div>
    <div class="signal-fdr-onboarding" data-fdr-connectivity-target="recorderOnboarding" hidden>
      <div>
        <span class="signal-k">Recorder access</span>
        <strong data-fdr-connectivity-target="recorderOnboardingTitle">New recorder detected</strong>
        <small class="signal-fdr-wifi-status" data-fdr-connectivity-target="wifiRegistrationStatus" role="status"></small>
      </div>
      <button type="button" class="signal-tool-button is-primary"
              data-action="fdr-connectivity#onboardRecorder"
              data-fdr-connectivity-target="wifiRegisterButton">
        <%= sillage_icon "shield", size: 15 %>
        <span data-fdr-connectivity-target="wifiRegisterLabel">Add and initialize recorder</span>
      </button>
    </div>
    <details <%= "open" unless local_assigns[:workspace] %>><summary>Recorder details and diagnostics</summary>
    <dl class="signal-fdr-status-list">
      <div>
        <dt>Recorder</dt>
        <dd class="signal-fdr-recorder-identification">
          <span data-fdr-connectivity-target="recorderDevice">Unavailable</span>
          <small data-fdr-connectivity-target="recorderSystem" hidden></small>
          <span class="signal-fdr-firmware" data-fdr-connectivity-target="recorderFirmwareGroup" hidden>(<span data-fdr-connectivity-target="recorderFirmware">Unavailable</span>)</span>
        </dd>
      </div>
      <div hidden>
        <dt>Hardware reference</dt>
        <dd data-fdr-connectivity-target="recorderEcu">Unavailable</dd>
      </div>
      <div>
        <dt>Synchronization</dt>
        <dd class="signal-fdr-synchronization">
          <span data-fdr-connectivity-target="lastSync">Unavailable</span>

        </dd>
      </div>
      <div><dt>Health</dt><dd data-fdr-connectivity-target="health">Unavailable</dd></div>
      <div><dt>Storage</dt><dd data-fdr-connectivity-target="storage">Unavailable</dd></div>
    </dl>
    </details>
  </section>

  <details class="signal-fdr-tools">
    <summary class="signal-fdr-tools-summary">
      <div><strong>Advanced diagnostics</strong></div>
      <small data-fdr-connectivity-target="recorderToolsHint">USB-C or Bluetooth required</small>
    </summary>
    <div class="signal-fdr-tools-body signal-fdr-tools-body--diagnostics">
      <div class="signal-fdr-diagnostics">
        <header class="signal-fdr-section-head">
          <div>
            <h3>Engineering log</h3>
            <small>Recent low-level recorder messages for troubleshooting.</small>
          </div>
          <button type="button" class="signal-fdr-debug-button" disabled data-action="fdr-connectivity#refreshDebug" data-fdr-connectivity-target="debugButton">Refresh debug log</button>
        </header>
        <pre class="signal-fdr-debug" data-fdr-connectivity-target="debug">No debug snapshot loaded.</pre>
      </div>
    </div>
  </details>
</section>
