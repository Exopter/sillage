<% label = @assembly&.display_name || @fdr&.display_name %>
<header class="exds-recorder-heading">
  <div>
    <h1><%= { overview: "Device", files: "Recordings", connectivity: "Connections", calibration: "Calibration", activity: "History" }.fetch(active_tab, "Device") %></h1>
    <p><%= label %></p>
    <% if (system = @assembly&.fdr_system_at) %><small>System: <%= link_to system.serial_number, hangar_assembly_path(system) %></small><% end %>
  </div>
  <% if active_tab == :files %>
    <%= render "forge/fdrs/recording_control" %>
  <% elsif active_tab == :connectivity %>
    <div class="workspace-actions">
      <button type="button" class="button-secondary" data-fdr-wifi-configuration-target="usbButton" data-action="fdr-wifi-configuration#connectUsb"><span data-recorder-button-label>Connect USB-C</span></button>
      <button type="button" class="button-secondary" data-fdr-wifi-configuration-target="bleButton" data-action="fdr-wifi-configuration#connectBle"><span data-recorder-button-label>Connect Bluetooth</span></button>
      <%= link_to "Back to device", forge_fdr_path(@assembly&.serial_number || @fdr.id), class: "button-secondary" %>
    </div>
  <% elsif active_tab == :overview && @assembly %>
    <%= link_to "Edit in Hangar", edit_hangar_assembly_path(@assembly), class: "button-secondary" %>
  <% end %>
</header>
