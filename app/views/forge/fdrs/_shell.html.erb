<nav class="fdr-breadcrumb" aria-label="FDR breadcrumb">
  <%= link_to "Forge", forge_path %>
  <%= sillage_icon "chevron-right", size: 13 %>
  <%= link_to "Embedded controllers", forge_fdrs_path %>
  <%= sillage_icon "chevron-right", size: 13 %>
  <span aria-current="page"><%= @fdr.technical_reference %></span>
</nav>

<header class="fdr-connectivity-heading">
  <div>
    <span class="section-eyebrow">Embedded controller</span>
    <h2><%= @fdr.technical_reference %></h2>
    <p>
      Hardware platform: <%= @fdr.device_model.presence || "not reported" %>
      <% if @controller_part %>· Part <%= @controller_part.internal_number %><% else %>· No controller part assigned<% end %>
      <% if @assembly %>· <%= @assembly.display_name %> · <%= @assembly.identity_label %><% end %>
      <% if @aircraft %>· Installed in <%= @aircraft.registration %><% end %>
    </p>
  </div>

  <div class="fdr-connectivity-actions">
    <% if active_tab == :connectivity %>
      <button type="button" class="button-secondary" data-fdr-wifi-configuration-target="usbButton" data-action="fdr-wifi-configuration#connectUsb">
        <%= sillage_icon "usb-c", size: 16, stroke_width: 2.4 %>
        <span>Connect USB-C</span>
      </button>
      <button type="button" class="button-secondary" data-fdr-wifi-configuration-target="bleButton" data-action="fdr-wifi-configuration#connectBle">
        <%= sillage_icon "bluetooth", size: 16 %>
        <span>Connect BLE</span>
      </button>
    <% elsif @assembly %>
      <%= link_to "Create build", new_forge_build_path(build: { assembly_id: @assembly.id }), class: "button-primary" %>
      <%= link_to "Open ExoFDR assembly", hangar_assembly_path(@assembly), class: "button-secondary" %>
    <% end %>
  </div>
</header>

<nav class="fdr-recorder-tabs" aria-label="FDR sections">
  <%= link_to "Overview", forge_fdr_path(@fdr),
    class: ("is-active" if active_tab == :overview),
    aria: { current: ("page" if active_tab == :overview) } %>
  <%= link_to "Connectivity", connectivity_forge_fdr_path(@fdr),
    class: ("is-active" if active_tab == :connectivity),
    aria: { current: ("page" if active_tab == :connectivity) } %>
  <%= link_to "Activity", activity_forge_fdr_path(@fdr),
    class: ("is-active" if active_tab == :activity),
    aria: { current: ("page" if active_tab == :activity) } %>
</nav>
