<% content_for :title, "Embedded controllers" %>
<%= render "forge/tabs" %>

<header class="workspace-header recorder-fleet-header">
  <div>
    <h1>Embedded controllers</h1>
    <p>Technical identity, connectivity, and security state for interchangeable ExoFDR controller parts.</p>
  </div>
</header>

<%= render "connection_manager" %>

<section id="registered-recorders" class="workspace-panel">
  <div class="workspace-panel-header">
    <h2>Registered controllers</h2>
    <span><%= pluralize @fdrs.size, "controller" %></span>
  </div>
  <% if @fdrs.any? %>
    <div class="workspace-table-wrap">
      <table class="workspace-table">
        <thead><tr><th>Recorder / ECU</th><th>Controller part</th><th>Firmware</th><th>Signal</th></tr></thead>
        <tbody>
          <% @fdrs.each do |fdr| %>
            <% presence = fdr.signal_presence %>
            <% live = presence&.fresh? %>
            <tr>
              <td><%= link_to fdr.display_name, forge_fdr_path(fdr), class: "workspace-strong-link" %><br><small class="workspace-muted"><%= fdr.technical_reference %></small></td>
              <td><% if fdr.part %><%= link_to fdr.part.display_name, hangar_part_path(fdr.part), class: "workspace-strong-link" %><br><small class="workspace-muted">Asset ID <%= fdr.part.internal_number %></small><% else %><span class="workspace-muted">Not assigned</span><% end %></td>
              <td><%= fdr.last_seen_firmware.presence || "Not reported" %></td>
              <td><span class="workspace-status <%= live ? "is-installed" : "is-draft" %>"><%= live ? "Live" : "Offline" %></span><% if presence&.last_seen_at %><br><small class="workspace-muted"><%= time_ago_in_words(presence.last_seen_at) %> ago</small><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="workspace-empty">No embedded controller is registered yet. Connect an ECU over USB-C or BLE to add it securely.</div>
  <% end %>
</section>
