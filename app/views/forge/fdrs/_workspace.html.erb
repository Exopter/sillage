<% content_for :body_class, "exds-recorder-page" %>
<% identifier = @assembly&.serial_number || @fdr&.id %>
<% active = action_name == "files" ? :recordings : action_name == "calibration" ? :calibration : action_name == "activity" ? :history : :device %>
<div class="exds-recorder-workspace">
  <%# The module list is the way to another recorder: go back to it, as everywhere else. %>
  <% if identifier %>
  <aside class="exds-recorder-sidebar" aria-label="Forge workspace">
    <%= link_to "FDRs", forge_path, class: "exds-back-link" %>
    <% if identifier %>
      <nav class="exds-recorder-nav" aria-label="FDR sections">
        <% [["Recordings", files_forge_fdr_path(identifier), :recordings], ["Device", forge_fdr_path(identifier), :device], ["Calibration", calibration_forge_fdr_path(identifier), :calibration]].each do |label, path, tab| %>
          <%= link_to path, aria: { current: ("page" if active == tab) } do %><span><%= label %></span><% end %>
        <% end %>
      </nav>
    <% end %>
    <nav class="exds-recorder-nav exds-recorder-nav--secondary" aria-label="Recorder management">
      <% if identifier %><%= link_to activity_forge_fdr_path(identifier), aria: { current: ("page" if active == :history) } do %><span>History</span><% end %><% end %>
      <%= link_to forge_path(connect: 1) do %><%= sillage_icon "plus", size: 16 %><span>Add recorder</span><% end %>
    </nav>
  </aside>
  <% end %>
  <div class="exds-recorder-content"><%= yield %></div>
</div>
