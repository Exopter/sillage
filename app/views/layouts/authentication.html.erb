<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Sillage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg?v=exopter-20261115" type="image/svg+xml">
    <%= stylesheet_link_tag "exopter_fonts", "exopter_design_system", "exopter_semantics", "button", "icon_button", "input", "select", "application", "native_controls", "data-turbo-track": "reload" %>
  </head>
  <body class="authentication-page ex-dark">
    <header class="authentication-masthead">
      <span class="authentication-brand">
        <%= image_tag "logo-wordmark.svg", alt: "Exopter", class: "authentication-wordmark" %>
        <span>Sillage</span>
      </span>
      <span class="authentication-tagline">The story is ours to write</span>
    </header>
    <main class="authentication-shell">
      <section class="authentication-panel">
        <% flash.each do |type, message| %>
          <div class="flash <%= type %>"><%= message %></div>
        <% end %>
        <%= yield %>
      </section>
    </main>
  </body>
</html>
