<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg?v=exopter-ex-20261009" type="image/svg+xml">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "exopter_fonts", "exopter_design_system", "application", "icon_button_edge", "selection_toolbar", "column_browser", "feedback_popover", "flights", "signal", "hangar_forge", "calibration_guide", "signal_strength", "recorder_workspace", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %> <%= "exds-recorder-page" if controller_path == "forge/fdrs" %>" data-controller="recorder-presence">
    <div class="sillage-workbench">
      <aside id="sillage-room-rail" class="sillage-rail" aria-label="Sillage rooms">
        <%= link_to root_path, class: "sillage-home-link", aria: { label: "Sillage home" }, title: "Sillage home" do %>
          <%= image_tag "logo-shell.svg", width: 44, height: 30, alt: "" %>
        <% end %>
        <nav class="sillage-room-nav" aria-label="Primary rooms">
          <% sillage_room_items.each do |item| %>
            <% classes = ["sillage-room-link", ("is-active" if item[:id] == sillage_current_room), ("is-disabled" unless item[:enabled]), ("is-separated" if item[:separated])].compact.join(" ") %>
            <% if item[:href].present? %>
              <%= link_to item[:href], class: classes, title: item[:label], aria: { current: ("page" if item[:id] == sillage_current_room) } do %>
                <span class="sillage-room-icon"><%= sillage_icon item[:icon], size: 18, class_name: "sillage-room-svg" %></span>
                <span class="sillage-room-label"><%= item[:label] %></span>
              <% end %>
            <% else %>
              <span class="<%= classes %>" title="<%= item[:label] %>" aria-disabled="true">
                <span class="sillage-room-icon"><%= sillage_icon item[:icon], size: 18, class_name: "sillage-room-svg" %></span>
                <span class="sillage-room-label"><%= item[:label] %></span>
              </span>
            <% end %>
          <% end %>
        </nav>
        <% if Current.user&.admin? %>
          <%= link_to core_path,
            class: [ "sillage-room-link", "sillage-core-link", ("is-active" if sillage_current_room == "core") ],
            title: "Core",
            aria: { current: ("page" if sillage_current_room == "core") } do %>
            <span class="sillage-room-icon"><%= sillage_icon "shield", size: 18, class_name: "sillage-room-svg" %></span>
            <span class="sillage-room-label">Core</span>
          <% end %>
        <% end %>
      </aside>

      <div class="sillage-main">
        <header class="sillage-topbar">
          <%= yield :rail_control %>
          <div class="sillage-title-block">
            <nav class="sillage-breadcrumb" aria-label="Breadcrumb">
              <ol>
                <% sillage_breadcrumb_items.each do |item| %>
                  <li>
                    <% if item[:current] %>
                      <span aria-current="page"><%= item[:label] %></span>
                    <% elsif item[:href].present? %>
                      <%= link_to item[:label], item[:href] %>
                    <% else %>
                      <span><%= item[:label] %></span>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </nav>
            <strong><%= sillage_shell_title %></strong>
          </div>

          <div class="sillage-topbar-spacer"></div>

          <%= yield :connection_metrics %>

          <%= yield :connection_control %>

          <details class="sillage-account-menu">
            <summary aria-label="Open account menu">
              <span class="sillage-avatar" aria-hidden="true"><%= sillage_user_initials(Current.user) %></span>
            </summary>
            <div class="sillage-account-popover" role="menu">
              <strong>Account</strong>
              <span><%= Current.user&.email_address %></span>
              <% if Current.user&.admin? %>
                <%= link_to "Users", core_users_path, class: "sillage-account-action" %>
                <%= link_to "Feedback inbox", core_feedbacks_path, class: "sillage-account-action" %>
              <% end %>
              <%= button_to logout_path, method: :delete, class: "sillage-account-action", form: { role: "none" } do %>
                <%= sillage_icon "log-out", size: 15 %>
                <span>Log out</span>
              <% end %>
            </div>
          </details>
        </header>

        <%= render "shared/flashes" unless sillage_flight_browser? %>

        <main class="sillage-content">
          <div class="<%= sillage_content_shell_class %>">
            <% if controller_path == "forge/fdrs" %>
              <%= render "forge/fdrs/workspace" do %><%= yield %><% end %>
            <% else %><%= yield %><% end %>
          </div>
        </main>
      </div>
    </div>
    <%= render "feedbacks/widget" if Current.user %>
  </body>
</html>
