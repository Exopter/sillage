<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Flight Club" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#070b0d">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg?v=exopter-20261115" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=exopter-20261115">
    <%= stylesheet_link_tag "exopter_fonts", "exopter_design_system", "exopter_semantics", "application", "flight_club", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flight-club-page ex-dark">
    <%= yield %>
  </body>
</html>
