<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Exopter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Exopter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg?v=exopter-20261115" type="image/svg+xml">
    <%= stylesheet_link_tag "exopter_fonts", "exopter_design_system", "exopter_semantics", "button", "icon_button", "input", "select", "wing_blueprint", "flight_scene", "landing", "native_controls", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "landing", importmap: landing_importmap %>
  </head>

  <body class="landing-page">
    <%= yield %>
  </body>
</html>
