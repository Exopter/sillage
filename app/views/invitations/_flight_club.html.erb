<% content_for :title, "Your Flight Club invitation" %>

<main class="flight-club-welcome" data-stage="invitation">
  <%= render "shared/flight_club_masthead", member: user %>

  <section class="flight-club-prelude" aria-labelledby="flight-club-invitation-title">
    <span class="flight-club-emblem"><%= image_tag "logo-mark.svg", alt: "" %></span>
    <span class="flight-club-micro">A personal invitation</span>
    <h1 id="flight-club-invitation-title"><%= user.first_name %>, your place is ready.</h1>
    <p>You are joining Flight Club as <%= user.membership_rank_phrase %>.<br>Choose a password to secure your membership, then meet your card.</p>

    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>

    <%= form_with url: invitation_path(params[:token]), method: :patch, class: "flight-club-form" do |form| %>
      <label>
        <span>Password</span>
        <%= form.password_field :password, autocomplete: "new-password", required: true, minlength: 8 %>
      </label>
      <label>
        <span>Confirm password</span>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, minlength: 8 %>
      </label>
      <button type="submit" class="flight-club-action">
        <span>Secure my membership</span><span aria-hidden="true">↗</span>
      </button>
    <% end %>

    <span class="flight-club-micro">Reserved for <%= user.email_address %> / valid until <%= user.invitation_expires_at.strftime("%-d %B %Y") %></span>
  </section>
</main>
