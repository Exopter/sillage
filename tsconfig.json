{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "exs1_contract": [
        "./app/javascript/lib/exs1_contract.js"
      ],
      "fdr_sync_protocol": [
        "./app/javascript/lib/fdr_sync_protocol.js"
      ],
      "fdr_wifi_provisioning": [
        "./app/javascript/lib/fdr_wifi_provisioning.js"
      ],
      "usb_page_lifecycle": [
        "./app/javascript/lib/usb_page_lifecycle.js"
      ],
      "aircraft_connection": [
        "./app/javascript/lib/aircraft_connection.js"
      ],
      "fdr_partial_file": [
        "./app/javascript/lib/fdr_partial_file.js"
      ],
      "viewer_resources": [
        "./app/javascript/lib/viewer_resources.js"
      ],
      "pressure_altitude": [
        "./app/javascript/lib/pressure_altitude.js"
      ],
      "signal_layout": [
        "./app/javascript/lib/signal_layout.js"
      ],
      "signal_telemetry": [
        "./app/javascript/lib/signal_telemetry.js"
      ],
      "signal_instruments": [
        "./app/javascript/lib/signal_instruments.js"
      ],
      "signal_map": [
        "./app/javascript/lib/signal_map.js"
      ],
      "flight_geometry": [
        "./app/javascript/lib/flight_geometry.js"
      ],
      "signal_outbox": [
        "./app/javascript/lib/signal_outbox.js"
      ],
      "flight_chart_plugins": [
        "./app/javascript/lib/flight_chart_plugins.js"
      ],
      "fdr_heartbeat": [
        "./app/javascript/lib/fdr_heartbeat.js"
      ],
      "controllers/*": [
        "./app/javascript/controllers/*"
      ],
      "controllers": [
        "./app/javascript/controllers/index.js"
      ],
      "fdr_api": [
        "./app/javascript/lib/fdr_api.js"
      ],
      "recorder_identity": [
        "./app/javascript/lib/recorder_identity.js"
      ],
      "landing_scene": [
        "./app/javascript/lib/landing_scene.js"
      ],
      "landing_flow": [
        "./app/javascript/lib/landing_flow.js"
      ],
      "imu_health": [
        "./app/javascript/lib/imu_health.js"
      ],
      "imu_tutorial": [
        "./app/javascript/lib/imu_tutorial.js"
      ]
    },
    "strict": true,
    "target": "ES2022",
    "types": [
      "w3c-web-serial",
      "web-bluetooth"
    ]
  },
  "include": [
    "app/javascript/**/*.js",
    "app/javascript/types/**/*.d.ts"
  ]
}
