# Copy to `.env.deploy.local`, then fill local deployment values.
# This file is safe to commit. `.env.deploy.local` is ignored by Git.

RAILS_MASTER_KEY=
KAMAL_REGISTRY_PASSWORD=
CESIUM_ION_TOKEN=
POSTGRES_PASSWORD=

SILLAGE_LANDING_HOSTS=exopter.com
SILLAGE_HOSTS=sillage.exopter.com
SILLAGE_LANDING_BASIC_AUTH_USERNAME=
SILLAGE_LANDING_BASIC_AUTH_PASSWORD=

# Nominatim-compatible reverse geocoder used for automatic landing locations.
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=Sillage/1.0 (https://sillage.exopter.com)
NOMINATIM_LANGUAGE=en

EMAIL_ENABLED=false
MAIL_FROM=
MAIL_FROM_NAME=Exopter
MAIL_REPLY_TO=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=

# Ops industrialization flags. Enabling either surface requires every related
# value below; deployment fails fast when the configuration is incomplete.
BACKUPS_ENABLED=false
MONITORING_ENABLED=false
BACKUP_PLAN_URL=
MONITORING_PLAN_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=sillage-backups
PGBACKREST_REPOSITORY_PASSWORD=
RESTIC_REPOSITORY_PASSWORD=
HEALTHCHECKS_READY_PING_URL=
HEALTHCHECKS_POSTGRESQL_ARCHIVE_PING_URL=
HEALTHCHECKS_POSTGRESQL_BACKUP_PING_URL=
HEALTHCHECKS_STORAGE_BACKUP_PING_URL=
HEALTHCHECKS_API_READ_KEY=
# Direct SSH/build target; public hostnames may be proxied by Cloudflare.
KAMAL_DEPLOY_HOST=157.90.155.63
