# Copy this file to .kamal/secrets before deploying.
# Keep real values in .env.deploy.local; .kamal/secrets is only a Kamal bridge.

# Required by Rails credentials in production.
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Dummy credential for the private no-auth registry bound to 127.0.0.1 on the VPS.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Optional browser-safe Cesium ion token for terrain, imagery, and 3D tiles.
CESIUM_ION_TOKEN=$CESIUM_ION_TOKEN

# HTTP Basic Auth for the public landing host.
SILLAGE_LANDING_BASIC_AUTH_USERNAME=$SILLAGE_LANDING_BASIC_AUTH_USERNAME
SILLAGE_LANDING_BASIC_AUTH_PASSWORD=$SILLAGE_LANDING_BASIC_AUTH_PASSWORD

# Postmark delivery token. Required only when EMAIL_ENABLED=true.
POSTMARK_SERVER_TOKEN=$POSTMARK_SERVER_TOKEN

# Project-local PostgreSQL service credential.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Bucket-scoped R2 credentials exposed under pgBackRest's expected names.
PGBACKREST_REPO1_S3_KEY=$R2_ACCESS_KEY_ID
PGBACKREST_REPO1_S3_KEY_SECRET=$R2_SECRET_ACCESS_KEY
PGBACKREST_REPO1_CIPHER_PASS=$PGBACKREST_REPOSITORY_PASSWORD

# OpenAI API credential, separate from Codex authentication.
OPENAI_API_KEY=$OPENAI_API_KEY

# Key of the shared object storage bucket. Required only when TUNNEL_MEDIA_URL is set.
OBJECT_STORAGE_ACCESS_KEY_ID=$OBJECT_STORAGE_ACCESS_KEY_ID
OBJECT_STORAGE_SECRET_ACCESS_KEY=$OBJECT_STORAGE_SECRET_ACCESS_KEY

# Tunnel media portal account. Required only when TUNNEL_MEDIA_URL is set.
TUNNEL_MEDIA_PASSWORD=$TUNNEL_MEDIA_PASSWORD
