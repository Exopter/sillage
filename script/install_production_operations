#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "shellwords"
require "tempfile"

CONFIRMATION = "INSTALL_AND_ENABLE"
ROOT = File.expand_path("..", __dir__)
ENV_PATH = File.join(ROOT, ".env.deploy.local")
REQUIRED = %w[
  KAMAL_DEPLOY_HOST R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_BACKUP_BUCKET
  PGBACKREST_REPOSITORY_PASSWORD RESTIC_REPOSITORY_PASSWORD
  HEALTHCHECKS_READY_PING_URL HEALTHCHECKS_POSTGRESQL_ARCHIVE_PING_URL
  HEALTHCHECKS_POSTGRESQL_BACKUP_PING_URL HEALTHCHECKS_STORAGE_BACKUP_PING_URL
].freeze

abort "PRODUCTION_OPERATIONS_CONFIRM must equal #{CONFIRMATION}" unless ENV["PRODUCTION_OPERATIONS_CONFIRM"] == CONFIRMATION
abort "Missing #{ENV_PATH}" unless File.file?(ENV_PATH)

File.readlines(ENV_PATH, chomp: true).each do |line|
  line = line.strip
  next if line.empty? || line.start_with?("#")

  key, value = line.sub(/\Aexport\s+/, "").split("=", 2)
  next if key.to_s.empty? || value.nil?

  value = value.strip
  quote = value[0]
  value = value[1...-1] if [ "'", '"' ].include?(quote) && value.end_with?(quote)
  ENV[key.strip] ||= value
end

missing = REQUIRED.select { |key| ENV[key].to_s.strip.empty? }
abort "Missing production operation variables: #{missing.join(', ')}" if missing.any?

def run!(*command)
  stdout, stderr, status = Open3.capture3(*command)
  return stdout if status.success?

  warn stderr
  abort "Command failed: #{command.first}"
end

host = ENV.fetch("KAMAL_DEPLOY_HOST")
ssh = [ "ssh", "-i", File.expand_path("~/.ssh/kamal_deploy"), "-o", "BatchMode=yes", "root@#{host}" ]
scp = [ "scp", "-i", File.expand_path("~/.ssh/kamal_deploy"), "-o", "BatchMode=yes" ]
stage = "/tmp/sillage-operations-install-#{Process.pid}"
operations_env = {
  "R2_ACCOUNT_ID" => ENV.fetch("R2_ACCOUNT_ID"),
  "R2_ACCESS_KEY_ID" => ENV.fetch("R2_ACCESS_KEY_ID"),
  "R2_SECRET_ACCESS_KEY" => ENV.fetch("R2_SECRET_ACCESS_KEY"),
  "R2_BACKUP_BUCKET" => ENV.fetch("R2_BACKUP_BUCKET"),
  "PGBACKREST_REPOSITORY_PASSWORD" => ENV.fetch("PGBACKREST_REPOSITORY_PASSWORD"),
  "RESTIC_REPOSITORY_PASSWORD" => ENV.fetch("RESTIC_REPOSITORY_PASSWORD"),
  "HEALTHCHECKS_READY_PING_URL" => ENV.fetch("HEALTHCHECKS_READY_PING_URL"),
  "HEALTHCHECKS_POSTGRESQL_ARCHIVE_PING_URL" => ENV.fetch("HEALTHCHECKS_POSTGRESQL_ARCHIVE_PING_URL"),
  "HEALTHCHECKS_POSTGRESQL_BACKUP_PING_URL" => ENV.fetch("HEALTHCHECKS_POSTGRESQL_BACKUP_PING_URL"),
  "HEALTHCHECKS_STORAGE_BACKUP_PING_URL" => ENV.fetch("HEALTHCHECKS_STORAGE_BACKUP_PING_URL")
}

run!(*ssh, "install -d -m 0700 #{Shellwords.escape(stage)}")

Tempfile.create("sillage-operations.env") do |file|
  file.chmod(0o600)
  operations_env.each do |key, value|
    abort "Invalid newline in #{key}" if value.include?("\n")

    file.puts "#{key}=#{Shellwords.escape(value)}"
  end
  file.flush
  run!(*scp, file.path, "root@#{host}:#{stage}/operations.env")
end

files = [ File.join(ROOT, "ops/bin/sillage-operations"), *Dir[File.join(ROOT, "ops/systemd/sillage-*")] ]
run!(*scp, *files, "root@#{host}:#{stage}/")

install_command = <<~SHELL
  set -eu
  install -d -m 0755 /etc/sillage /usr/local/libexec /var/lib/sillage-operations
  install -m 0600 #{Shellwords.escape(stage)}/operations.env /etc/sillage/operations.env
  install -m 0755 #{Shellwords.escape(stage)}/sillage-operations /usr/local/libexec/sillage-operations
  for unit in #{Shellwords.escape(stage)}/sillage-*.service #{Shellwords.escape(stage)}/sillage-*.timer; do
    install -m 0644 "$unit" "/etc/systemd/system/$(basename "$unit")"
  done
  docker volume create sillage_restic_cache >/dev/null
  docker pull restic/restic:0.18.0@sha256:28f29bcc3d38a061e09f825600244cf9854f09dd59443e9cd1dfa038c22b43d2 >/dev/null
  systemctl daemon-reload
  systemctl enable --now \
    sillage-ready-monitor.timer \
    sillage-postgresql-archive-monitor.timer \
    sillage-postgresql-backup.timer \
    sillage-active-storage-backup.timer \
    sillage-active-storage-prune.timer
  rm -r #{Shellwords.escape(stage)}
SHELL
run!(*ssh, install_command)
puts "Production backup and monitoring units are installed and enabled on #{host}."
