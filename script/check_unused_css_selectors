#!/usr/bin/env ruby
# frozen_string_literal: true

require "set"

ROOT = File.expand_path("..", __dir__)
STYLESHEET_GLOB = File.join(ROOT, "app/assets/stylesheets/**/*.css")
CANONICAL_TOKEN_STYLESHEET = File.join(ROOT, "app/assets/stylesheets/exopter_design_system.css")
CONSUMER_GLOBS = %w[
  app/components/**/*.{erb,rb}
  app/helpers/**/*.rb
  app/javascript/**/*.{js,mjs}
  app/views/**/*.{erb,html}
].freeze

# These selectors belong to markup created by Rails or third-party JavaScript.
RUNTIME_CLASSES = Set.new(%w[
  cesium-credit-expand-link
  cesium-credit-logoContainer
  cesium-credit-textContainer
  cesium-widget
  cesium-widget-credits
  is-available
  is-caution
  is-failed
  is-fault
  is-installed
  is-level-1
  is-level-2
  is-level-3
  is-quarantined
  is-ready
  is-retired
  notice
]).freeze

stylesheets = Dir[STYLESHEET_GLOB].sort
consumers = CONSUMER_GLOBS.flat_map { |glob| Dir[File.join(ROOT, glob)] }.uniq.sort
consumer_source = consumers.map { |path| File.read(path) }.join("\n")
stylesheet_sources = stylesheets.to_h { |path| [ path, File.read(path) ] }

defined_classes = stylesheet_sources.values.flat_map do |source|
  source.scan(/([^{}]+)\{/).flat_map do |selector|
    selector.first.scan(/\.([A-Za-z_][A-Za-z0-9_-]*)/).flatten
  end
end.to_set

unused_classes = defined_classes.reject do |name|
  RUNTIME_CLASSES.include?(name) || consumer_source.match?(/(?<![A-Za-z0-9_-])#{Regexp.escape(name)}(?![A-Za-z0-9_-])/)
end.sort

local_custom_properties = stylesheet_sources.reject { |path, _source| path == CANONICAL_TOKEN_STYLESHEET }.values.flat_map do |source|
  source.scan(/^\s*(--[A-Za-z0-9_-]+)\s*:/).flatten
end.uniq.sort
stylesheet_usage_source = stylesheet_sources.values.join("\n").gsub(/^\s*--[A-Za-z0-9_-]+\s*:/, "")
custom_property_consumer_source = "#{stylesheet_usage_source}\n#{consumer_source}"
unused_custom_properties = local_custom_properties.reject do |name|
  custom_property_consumer_source.match?(/(?<![A-Za-z0-9_-])#{Regexp.escape(name)}(?![A-Za-z0-9_-])/)
end

if unused_classes.empty? && unused_custom_properties.empty?
  puts "Unused CSS guard passed: every declared class and local custom property has a consumer."
  exit 0
end

unless unused_classes.empty?
  warn "CSS classes without a consumer:"
  unused_classes.each { |name| warn "  .#{name}" }
  warn "Remove the selector or document a runtime-generated consumer in RUNTIME_CLASSES."
end

unless unused_custom_properties.empty?
  warn "Local CSS custom properties without a consumer:"
  unused_custom_properties.each { |name| warn "  #{name}" }
  warn "Remove the property or consume the canonical design-system token directly."
end

exit 1
