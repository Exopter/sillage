[Unit]
Description=Sillage PostgreSQL archive freshness monitor
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/sillage/operations.env
ExecStart=/usr/local/libexec/sillage-operations postgresql-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock /var/lib/sillage-operations
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=60
