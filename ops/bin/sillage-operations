#!/usr/bin/env bash
set -Eeuo pipefail

readonly POSTGRES_CONTAINER="sillage-postgres"
readonly STATE_DIRECTORY="${SILLAGE_OPERATIONS_STATE_DIRECTORY:-/var/lib/sillage-operations}"
readonly RESTIC_IMAGE="restic/restic:0.18.0@sha256:28f29bcc3d38a061e09f825600244cf9854f09dd59443e9cd1dfa038c22b43d2"
readonly RCLONE_IMAGE="rclone/rclone:1.69.1@sha256:600f51856285df1ae5d91c8bb2682cbbe31bf109ebeeef9ecead6ca8c0ff6138"
readonly POSTGRES_BACKUP_STAMP="${STATE_DIRECTORY}/postgresql-backup.success"

require_variable() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    echo "Required environment variable is missing: ${name}" >&2
    return 1
  fi
}

ping_healthcheck() {
  local url="$1"
  local suffix="${2:-}"
  local message="${3:-}"

  curl --fail --silent --show-error --max-time 10 --retry 2 \
    --request POST --data-binary "$message" "${url}${suffix}" >/dev/null || true
}

run_monitored() {
  local url="$1"
  local send_start="$2"
  shift 2

  # Only confirmed success refreshes the deadline; failures use the configured grace.

  local output
  if output=$("$@" 2>&1); then
    ping_healthcheck "$url" "" "${output:-ok}"
    [[ -z "$output" ]] || printf '%s\n' "$output"
  else
    local status=$?
    ping_healthcheck "$url" "/log" "${output:-failed}"
    [[ -n "$output" ]] && printf '%s\n' "$output" >&2
    return "$status"
  fi
}

acquire_lock() {
  local name="$1"
  exec 9>"/run/lock/sillage-${name}.lock"
  if ! flock --nonblock 9; then
    echo "Another Sillage ${name} operation is already running." >&2
    return 75
  fi
}

# Persist failures across timer invocations. A missing heartbeat still expires normally.
readiness_signal() {
  local status="$1" state="$2" now previous=0 count=0
  now=$(date +%s) || return
  if [[ -f "$state" ]]; then
    read -r previous count < "$state" || return
    if [[ ! "$previous" =~ ^[0-9]+$ || ! "$count" =~ ^[0-9]+$ ]]; then
      echo "Invalid readiness state" >&2
      return 1
    fi
  fi
  if (( status == 0 )); then
    rm -f "$state" || return
    echo success
    return
  fi
  # Do not combine unrelated failures after a monitor interruption.
  if (( now < previous || now - previous > 180 )); then count=0; fi
  if (( count < 2 )); then count=$((count + 1)); fi
  printf '%s %s\n' "$now" "$count" > "${state}.tmp" || return
  mv "${state}.tmp" "$state" || return
  echo "Readiness failed: consecutive cycles ${count}/2" >&2
  # Diagnostic counters do not bypass the server-side grace period.
  echo log
}

monitor_ready() {
  local output status=0 signal
  output=$(check_ready 2>&1) || status=$?
  printf '%s\n' "$output"
  signal=$(readiness_signal "$status" "$STATE_DIRECTORY/ready.failures") || return
  case "$signal" in
    success) ping_healthcheck "$HEALTHCHECKS_READY_PING_URL" "" "$output" ;;
    log|fail) ping_healthcheck "$HEALTHCHECKS_READY_PING_URL" "/$signal" "$output" ;;
  esac
  return "$status"
}

check_ready() {
  local response
  response=$(curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 30 https://sillage.exopter.com/ready) || {
    local status=$?
    printf 'Readiness request failed: %s\n' "$response" >&2
    return "$status"
  }
  grep --quiet --extended-regexp '^[[:space:]]*\{[[:space:]]*"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$response" || {
    printf 'Invalid readiness response: %s\n' "$response" >&2
    return 1
  }
  echo "Sillage readiness is healthy."
}

check_postgresql_archive() {
  local stats archive_age active_failure archived_count backup_age now backup_time
  stats=$(docker exec "$POSTGRES_CONTAINER" psql -U sillage -d sillage_production --no-align --tuples-only --field-separator='|' --command \
    "SELECT COALESCE(EXTRACT(EPOCH FROM clock_timestamp() - last_archived_time)::bigint, -1), CASE WHEN last_failed_time IS NOT NULL AND (last_archived_time IS NULL OR last_failed_time > last_archived_time) THEN 1 ELSE 0 END, archived_count FROM pg_stat_archiver;") || return
  IFS='|' read -r archive_age active_failure archived_count <<<"$stats"

  [[ "$archive_age" =~ ^[0-9]+$ ]] && (( archive_age <= 1200 )) || return 1
  [[ "$active_failure" == "0" ]] || return 1
  docker exec "$POSTGRES_CONTAINER" sh -ec \
    'errors=$(find /var/spool/pgbackrest -type f -name "*.error" -size +0c -print -quit) || exit; test -z "$errors"' || return

  [[ -f "$POSTGRES_BACKUP_STAMP" ]] || return 1
  now=$(date +%s) || return
  backup_time=$(stat --format='%Y' "$POSTGRES_BACKUP_STAMP") || return
  backup_age=$((now - backup_time))
  (( backup_age >= 0 && backup_age <= 93600 )) || return 1

  echo "PostgreSQL archive age=${archive_age}s archived=${archived_count}; base backup age=${backup_age}s."
}

backup_postgresql() {
  docker exec --user postgres "$POSTGRES_CONTAINER" \
    pgbackrest --stanza=sillage --type=full backup || return
  touch "$POSTGRES_BACKUP_STAMP" || return
  echo "PostgreSQL full backup completed."
}

run_restic() {
  require_variable R2_ACCOUNT_ID || return
  require_variable R2_ACCESS_KEY_ID || return
  require_variable R2_SECRET_ACCESS_KEY || return
  require_variable R2_BACKUP_BUCKET || return
  require_variable RESTIC_REPOSITORY_PASSWORD || return

  docker run --rm \
    --cpu-shares 2 \
    --cpus 0.50 \
    --memory 512m \
    --pids-limit 128 \
    --security-opt no-new-privileges \
    --tmpfs /tmp:rw,noexec,nosuid,size=256m \
    --volume sillage_storage:/data:ro \
    --volume sillage_restic_cache:/cache \
    --env AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
    --env AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
    --env RESTIC_CACHE_DIR=/cache \
    --env RESTIC_PASSWORD="$RESTIC_REPOSITORY_PASSWORD" \
    --env RESTIC_REPOSITORY="s3:https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com/${R2_BACKUP_BUCKET}/restic/active-storage" \
    "$RESTIC_IMAGE" "$@"
}

initialize_storage_repository() {
  run_restic snapshots >/dev/null 2>&1 || run_restic init || return
  echo "Active Storage backup repository is initialized."
}

backup_storage() {
  run_restic backup /data --host sillage-production --tag active-storage || return
  echo "Active Storage incremental backup completed."
}

prune_storage() {
  run_restic forget \
    --host sillage-production \
    --tag active-storage \
    --keep-within 24h \
    --keep-hourly 168 \
    --keep-daily 30 \
    --prune || return
  echo "Active Storage retention pruning completed."
}

# Copies the live object storage bucket to the R2 backup bucket. Both remotes are
# configured through the environment; no credential is written to disk.
run_rclone() {
  require_variable R2_ACCOUNT_ID || return
  require_variable R2_ACCESS_KEY_ID || return
  require_variable R2_SECRET_ACCESS_KEY || return
  require_variable R2_BACKUP_BUCKET || return
  require_variable OBJECT_STORAGE_ENDPOINT || return
  require_variable OBJECT_STORAGE_REGION || return
  require_variable OBJECT_STORAGE_BUCKET || return
  require_variable OBJECT_STORAGE_ACCESS_KEY_ID || return
  require_variable OBJECT_STORAGE_SECRET_ACCESS_KEY || return

  docker run --rm \
    --cpu-shares 2 \
    --cpus 0.50 \
    --memory 512m \
    --pids-limit 128 \
    --security-opt no-new-privileges \
    --tmpfs /tmp:rw,noexec,nosuid,size=64m \
    --env RCLONE_CONFIG_LIVE_TYPE=s3 \
    --env RCLONE_CONFIG_LIVE_PROVIDER=Other \
    --env RCLONE_CONFIG_LIVE_ENDPOINT="$OBJECT_STORAGE_ENDPOINT" \
    --env RCLONE_CONFIG_LIVE_REGION="$OBJECT_STORAGE_REGION" \
    --env RCLONE_CONFIG_LIVE_ACCESS_KEY_ID="$OBJECT_STORAGE_ACCESS_KEY_ID" \
    --env RCLONE_CONFIG_LIVE_SECRET_ACCESS_KEY="$OBJECT_STORAGE_SECRET_ACCESS_KEY" \
    --env RCLONE_CONFIG_BACKUP_TYPE=s3 \
    --env RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare \
    --env RCLONE_CONFIG_BACKUP_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com" \
    --env RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
    --env RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
    --env RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true \
    "$RCLONE_IMAGE" "$@" --transfers 2 --checkers 4 --s3-chunk-size 16M --stats 0
}

# Objects are immutable. Checking only recent source objects one by one keeps
# the hourly run free of destination listings.
backup_object_storage() {
  run_rclone copy "live:${OBJECT_STORAGE_BUCKET}" "backup:${R2_BACKUP_BUCKET}/object-storage/current" \
    --max-age 72h --no-traverse --immutable || return
  echo "Object storage incremental backup completed."
}

# Weekly full comparison: catches anything the hourly window missed and moves
# objects deleted from the live bucket under deleted/, which R2 expires.
reconcile_object_storage() {
  run_rclone sync "live:${OBJECT_STORAGE_BUCKET}" "backup:${R2_BACKUP_BUCKET}/object-storage/current" \
    --backup-dir "backup:${R2_BACKUP_BUCKET}/object-storage/deleted" || return
  echo "Object storage backup reconciliation completed."
}

main() {
mkdir -p "$STATE_DIRECTORY" || return

case "${1:-}" in
  ready)
    require_variable HEALTHCHECKS_READY_PING_URL
    acquire_lock ready
    monitor_ready
    ;;
  postgresql-monitor)
    require_variable HEALTHCHECKS_POSTGRESQL_ARCHIVE_PING_URL
    acquire_lock postgresql-monitor
    run_monitored "$HEALTHCHECKS_POSTGRESQL_ARCHIVE_PING_URL" no check_postgresql_archive
    ;;
  postgresql-backup)
    require_variable HEALTHCHECKS_POSTGRESQL_BACKUP_PING_URL
    acquire_lock postgresql-backup
    run_monitored "$HEALTHCHECKS_POSTGRESQL_BACKUP_PING_URL" yes backup_postgresql
    ;;
  storage-init)
    acquire_lock active-storage
    initialize_storage_repository
    ;;
  storage-backup)
    require_variable HEALTHCHECKS_STORAGE_BACKUP_PING_URL
    acquire_lock active-storage
    run_monitored "$HEALTHCHECKS_STORAGE_BACKUP_PING_URL" yes backup_storage
    ;;
  storage-prune)
    require_variable HEALTHCHECKS_STORAGE_BACKUP_PING_URL
    acquire_lock active-storage
    if ! output=$(prune_storage 2>&1); then
      ping_healthcheck "$HEALTHCHECKS_STORAGE_BACKUP_PING_URL" "/log" "$output"
      printf '%s\n' "$output" >&2
      exit 1
    fi
    printf '%s\n' "$output"
    ;;
  object-storage-backup)
    require_variable HEALTHCHECKS_OBJECT_STORAGE_BACKUP_PING_URL
    acquire_lock object-storage
    run_monitored "$HEALTHCHECKS_OBJECT_STORAGE_BACKUP_PING_URL" yes backup_object_storage
    ;;
  object-storage-reconcile)
    require_variable HEALTHCHECKS_OBJECT_STORAGE_BACKUP_PING_URL
    acquire_lock object-storage
    if ! output=$(reconcile_object_storage 2>&1); then
      ping_healthcheck "$HEALTHCHECKS_OBJECT_STORAGE_BACKUP_PING_URL" "/log" "$output"
      printf '%s\n' "$output" >&2
      exit 1
    fi
    printf '%s\n' "$output"
    ;;
  *)
    echo "Usage: $0 {ready|postgresql-monitor|postgresql-backup|storage-init|storage-backup|storage-prune|object-storage-backup|object-storage-reconcile}" >&2
    exit 64
    ;;
esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
