#!/usr/bin/env ruby
require "fileutils"
require "pg"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def start_local_postgres!
  return if ENV["CI"] || ENV["POSTGRES_HOST"]

  unless system("docker", "compose", "version", out: File::NULL, err: File::NULL)
    abort "Docker Compose is required for the default local PostgreSQL setup. Set POSTGRES_HOST to use an existing server."
  end

  system! "docker", "compose", "up", "-d", "postgres"
end

def wait_for_postgres!
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 30
  connection_options = {
    host: ENV.fetch("POSTGRES_HOST", "127.0.0.1"),
    port: ENV.fetch("POSTGRES_PORT", 55432),
    dbname: "postgres",
    user: ENV.fetch("POSTGRES_USER", "sillage"),
    password: ENV.fetch("POSTGRES_PASSWORD", "sillage"),
    connect_timeout: 2
  }

  loop do
    PG.connect(**connection_options) { |_connection| }
    break
  rescue PG::Error => error
    raise error if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.5
  end
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system! "npm ci"

  puts "\n== Starting PostgreSQL =="
  start_local_postgres!
  wait_for_postgres!

  puts "\n== Preparing database =="
  database_task = ARGV.include?("--reset") ? "db:reset" : "db:prepare"
  system! "bin/rails", database_task
  system!({ "RAILS_ENV" => "test" }, "bin/rails", database_task)

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
